# XcodeGen 生成物（真正的源是 project.yml，改这些文件会被下次 generate 覆盖）
*.xcodeproj
*.xcworkspace
mac/Sources/Info.plist
mac/Baobox.entitlements

# 构建产物
mac/build/
mac/build.noindex/
mac/DerivedData/
# 离线翻译的推理进程（make vendor 下载的 llama.cpp 预编译包）
mac/Vendor/
.DS_Store

# SwiftPM
.mac/build/
.swiftpm/


# Python 工具脚本（mac/scripts/mocap 等）跑出来的缓存
__pycache__/

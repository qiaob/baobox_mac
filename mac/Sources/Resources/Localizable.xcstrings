    "claudecode.settings.config.defaultModeHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default permission mode for new sessions." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新会话启动时的默认权限模式。" } } } },
    "claudecode.settings.config.mode.default" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default (ask each time)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认（每次询问）" } } } },
    "claudecode.settings.config.mode.acceptEdits" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accept edits" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动接受编辑" } } } },
    "claudecode.settings.config.mode.plan" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Plan mode" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "计划模式" } } } },
    "claudecode.settings.config.mode.bypass" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bypass all prompts (dangerous)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过所有确认（危险）" } } } },
    "claudecode.settings.config.mode.bypassWarning" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skips every permission prompt — Claude can run anything without asking. Use with caution." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过所有权限确认，Claude 可无提示执行任何操作，请谨慎。" } } } },
    "claudecode.settings.config.model" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认模型" } } } },
    "claudecode.settings.config.model.default" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow default" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟随默认" } } } },
    "claudecode.settings.config.modelHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model alias written to settings.json; 'Follow default' removes the key." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写入 settings.json 的模型别名；「跟随默认」则移除该键。" } } } },
    "claudecode.settings.config.cleanup" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Session retention" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会话保留天数" } } } },
    "claudecode.settings.config.cleanup.default" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow default" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟随默认" } } } },
    "claudecode.settings.config.cleanup.days %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld days" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 天" } } } },
    "claudecode.settings.config.cleanupHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sessions older than this are auto-cleaned by Claude Code; 'Follow default' removes the key." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "早于该天数的会话会被 Claude Code 自动清理；「跟随默认」则移除该键。" } } } },
    "claudecode.settings.config.permissions" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permission presets" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "权限规则" } } } },

    "focus.menu.endBreak" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End Break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束休息" } } } },
    "focus.menu.breakNow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a Break Now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在休息" } } } },

    "pin.defaultName" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pinned.png" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "贴图.png" } } } },
    "pin.menu.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Image" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制图片" } } } },
    "pin.menu.save" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save As…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "另存为…" } } } },
    "pin.menu.close" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close Pin" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭贴图" } } } },
    "clipboard.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clipboard" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "剪贴板" } } } },
    "clipboard.settings.snippetsSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Text snippets" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文本片段" } } } },
    "clipboard.settings.snippetsEmpty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No snippets yet. A snippet is a favourite you wrote yourself — it never expires and survives Clear History." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有片段。片段就是你自己写的收藏条目：不会过期，也不会被「清空历史」删掉。" } } } },
    "clipboard.settings.snippetTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Name" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "名称" } } } },
    "clipboard.settings.snippetKeyword" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keyword" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关键字" } } } },
    "clipboard.settings.snippetNew" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Snippet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新建片段" } } } },
    "clipboard.settings.snippetNewName" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New snippet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新片段" } } } },
    "clipboard.settings.snippetExpand" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Expand keywords as I type" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打字时展开关键字" } } } },
    "clipboard.settings.snippetPrefix" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Trigger prefix" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "触发前缀" } } } },
    "clipboard.settings.snippetRestore" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore the previous clipboard after expanding" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "展开后还原原本的剪贴板内容" } } } },
    "clipboard.settings.snippetRestoreHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Expansion works by writing the snippet to the clipboard and pasting it with a synthesized ⌘V — replacing whatever you last copied. With this on, your previous clipboard comes back about half a second after expanding; with it off, the snippet stays on the clipboard." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "展开的实现是「片段写入剪贴板 + 模拟 ⌘V 粘贴」，会顶掉你之前复制的内容。开启后，展开完约半秒会把剪贴板还原成之前的内容；关闭则片段内容留在剪贴板里，方便接着去别处 ⌘V。" } } } },
    "clipboard.settings.snippetNeedsAX" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keyword expansion needs Accessibility permission — grant it in System Settings › Privacy & Security › Accessibility." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关键字展开需要辅助功能权限，请在「系统设置 › 隐私与安全性 › 辅助功能」中授权。" } } } },
    "clipboard.settings.snippetHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Snippets show up under Favourites in the clipboard panel — same search, same ⏎ to paste. Give one a keyword and typing prefix+keyword anywhere expands it in place." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "片段就显示在剪贴板面板的「收藏」里——同一个搜索框、同样 ⏎ 粘贴。给它设个关键字后，在任何输入框打「前缀+关键字」就会就地展开。" } } } },
    "clipboard.snippetEditor.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit Snippet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "编辑片段" } } } },
    "clipboard.snippetEditor.titlePlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Optional — name this snippet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可选，给片段起个名" } } } },
    "clipboard.snippetEditor.keywordPlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "e.g. addr" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如 addr" } } } },
    "clipboard.snippetEditor.content" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Content" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内容" } } } },
    "clipboard.snippetEditor.done" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成" } } } },
    "clipboard.snippetEditor.untitled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Untitled" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未命名" } } } },
    "clipboard.snippetEditor.hint %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Type “%@” in any text field to expand it in place." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在任何输入框打「%@」即就地展开。" } } } },
    "clipboard.snippetEditor.noKeywordHint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Without a keyword it's just a favourite — search and paste it from the panel." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不设关键字则只是普通收藏，在面板里搜索粘贴。" } } } },
    "clipboard.tools.action.setKeyword" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set Keyword" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设关键字" } } } },
    "clipboard.settings.snippetPrivacy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keyword expansion watches your keystrokes to match the prefix. It keeps at most 32 characters in memory, never writes them to disk, never adds them to history, and is off until you turn it on. Apps on the ignore list below are skipped, and macOS hides keystrokes from password fields entirely." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关键字展开需要监听按键来匹配前缀：内存里最多保留 32 个字符，绝不落盘、绝不进历史，且默认关闭。下方忽略名单里的 App 不会展开；密码框等场景 macOS 本身就不会把按键交给我们。" } } } },
    "clipboard.menu.open" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Clipboard History" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开剪贴板历史" } } } },
    "clipboard.hotkey.pastePlain" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Paste last item as plain text" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纯文本粘贴上一条" } } } },
    "clipboard.panel.searchPlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search history" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索历史" } } } },
    "clipboard.chip.all" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全部" } } } },

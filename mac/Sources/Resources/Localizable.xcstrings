    "focus.action.notNow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not Now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先不了" } } } },
    "focus.action.ok" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好的" } } } },
    "focus.action.snooze10" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In 10 min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推迟 10 分钟" } } } },
    "focus.action.snooze5" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In 5 min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "推迟 5 分钟" } } } },
    "focus.action.restNow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest Now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在休息" } } } },
    "focus.warn.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break in 1 minute" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "1 分钟后休息" } } } },
    "focus.downgrade.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You've been busy for a while — take a moment to move" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刚才一直在忙，起来活动一下吧" } } } },
    "focus.bubble.waterTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time for some water" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "喝口水吧" } } } },
    "focus.bubble.waterBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay hydrated — a few sips will do." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "补充点水分，润润嗓子。" } } } },
    "focus.bubble.standTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time to stand up" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "起来活动一下" } } } },
    "focus.bubble.standBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You've been sitting a while — stand up and walk around." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "坐太久了，站起来走两步。" } } } },
    "focus.bubble.eyeTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Look into the distance" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "看看远处" } } } },
    "focus.bubble.breakTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Time for a break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "该休息一下了" } } } },

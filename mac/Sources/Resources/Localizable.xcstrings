    "settings.general.loginItem.requiresApproval" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Approve Baobox in System Settings → General → Login Items to finish enabling launch at login." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要你在「系统设置 → 通用 → 登录项」中批准 Baobox，开机自启才会生效。" } } } },

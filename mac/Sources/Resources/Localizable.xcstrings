    "ai.error.refused" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The cloud model declined this request." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "云端模型拒绝回答这条请求。" } } } },

    "phonetransfer.mode.lanHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Phone and Mac on the same Wi-Fi. Fastest, works offline." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "手机和电脑在同一个 Wi-Fi 下。速度最快，断网也能用。" } } } },
    "phonetransfer.mode.internetHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Phone anywhere (cellular, another network). Direct peer-to-peer, end-to-end encrypted, no relay server." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "手机在任何网络（流量、别的 Wi-Fi）。点对点直连、端到端加密，不经过中继服务器。" } } } },
    "phonetransfer.button.refresh" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Refresh QR Code" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "刷新二维码" } } } },

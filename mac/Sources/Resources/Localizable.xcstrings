    "screenshot.longshot.hud.height %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld pt stitched" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已拼接 %lld pt" } } } },
    "screenshot.longshot.hud.hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scroll the page — new content is stitched automatically" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "滚动页面即可继续向下拼接" } } } },
    "screenshot.longshot.hud.finish" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成" } } } },
    "screenshot.longshot.error.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing was stitched" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长截屏没有内容" } } } },
    "screenshot.longshot.error.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No content was captured. Select the scrollable area, then scroll while the capture bar is showing." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有拼接到任何内容。请框选可滚动的区域，并在控制条显示期间滚动页面。" } } } },

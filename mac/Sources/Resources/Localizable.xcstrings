    "phonetransfer.history.empty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Files and text you send or receive appear here." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "收发的文件和文字会显示在这里。" } } } },

    "focus.breakDone.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break's over!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息好啦！" } } } },
    "focus.breakDone.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ready for the next round?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始下一轮专注吗？" } } } },
    "focus.action.nextRound" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One More Round" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "再来一轮" } } } },
    "focus.action.endCycle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束" } } } },
    "focus.action.startRound" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始" } } } },

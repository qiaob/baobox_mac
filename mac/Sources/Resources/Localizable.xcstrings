    "meeting.menu.startOffline" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Recording an In-Person Meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始线下会议记录" } } } },
    "meeting.menu.finish" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End and Write Minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束并生成纪要" } } } },
    "meeting.action.finish" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End Meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束会议" } } } },
    "meeting.menu.startFree" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Free Listening" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始自由听译" } } } },
    "meeting.menu.stopFree" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Free Listening" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止自由听译" } } } },

    "meeting.settings.calendarSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calendar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "日历" } } } },
    "meeting.settings.calendarEnabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read calendars" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取日历" } } } },
    "meeting.settings.calendarHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses the calendars on this Mac (including synced Google, Outlook and other accounts) for the next meeting, reminders, one-click join and briefs. Read-only; nothing leaves this Mac. macOS asks for calendar access the first time you turn this on." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用这台 Mac 上的日历（含已同步的 Google、Outlook 等账户）显示下一场会议、会前提醒、一键入会与会前简报。只读，数据不出本机；第一次打开时系统会请求日历权限。" } } } },
    "meeting.settings.calendarsToRead" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calendars to read" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "读取的日历" } } } },
    "meeting.settings.calendarNone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No calendars on this Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 上没有日历" } } } },
    "meeting.settings.calendarNotDetermined" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calendar access hasn't been requested yet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有请求日历权限" } } } },
    "meeting.settings.calendarRequest" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Access…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "授权…" } } } },
    "meeting.settings.calendarWriteOnly" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baobox can only add events; reading them needs full access" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在只有「仅添加事件」权限，读取日历需要「完全访问」" } } } },
    "meeting.settings.calendarDenied" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calendar access is off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有日历权限" } } } },
    "meeting.settings.openPrivacy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "去系统设置" } } } },
    "meeting.settings.reminderLead" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remind me before a meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会前提醒" } } } },
    "meeting.settings.reminderOff" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关" } } } },
    "meeting.settings.reminderMinutes %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld min before" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提前 %lld 分钟" } } } },
    "meeting.settings.remindersPaused %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Meeting reminders are paused until %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议提醒已暂停到 %@" } } } },
    "meeting.settings.resumeReminders" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复" } } } },
    "meeting.settings.menuBarCountdown" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show the next meeting in the menu bar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单栏显示下一场倒计时" } } } },
    "meeting.settings.detectSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detection" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "检测" } } } },
    "meeting.settings.detectEnabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detect meetings automatically" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动检测会议" } } } },
    "meeting.settings.detectHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Asks whether to record when a calendar meeting with a link has started, or when a meeting app (Zoom, Tencent Meeting, DingTalk, Teams, Feishu, Webex, FaceTime, WeChat, Slack) starts a meeting — its meeting window opens (DingTalk; muted counts too) or it uses the microphone for a few seconds — or a browser uses the microphone on a meeting site (Google Meet, Teams, Zoom and more on the web). It only asks, never starts on its own, and asks once per meeting. Music and videos don't count, and a browser using the microphone isn't blamed on Slack or WeChat." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "日历里带会议链接的会议开始了、或会议 App（Zoom、腾讯会议、钉钉、Teams、飞书、Webex、FaceTime、微信、Slack）开始开会时 —— 打开了会议窗口（钉钉，静音入会也算）或用麦克风几秒以上 —— 或浏览器在会议网站（Google Meet、Teams、Zoom 网页版等）用麦克风时，问你要不要记录。只问不自己开始，同一场只问一次；放音乐、看视频不算，浏览器用麦克风也不会算到 Slack、微信头上。" } } } },
    "meeting.settings.ignoredApps" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apps not to detect" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "忽略名单" } } } },
    "meeting.settings.ignoredNone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "None. Choose “Don't Detect This App” on a detection bubble to add one." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有。在检测气泡上点「不再检测此 App」即可加入。" } } } },
    "meeting.settings.ignoredRemove" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除" } } } },
    "meeting.settings.autoStart" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start recording automatically for calendar meetings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "命中日历会议时自动开始记录" } } } },
    "meeting.settings.autoStartHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Instead of asking, starts recording (linked to the event) when a calendar meeting with a link begins, or when a meeting app is using the microphone during a calendar meeting. Ignoring a meeting's reminder turns this off for that meeting." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不再询问，直接开始记录（关联这场日历事件）：带链接的日历会议开始时，或日历会议期间会议 App 在用麦克风时。对某场会议的提醒点了「忽略」，那一场就不会自动开始。" } } } },
    "meeting.settings.selfTest" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Device check" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备自检" } } } },
    "meeting.settings.selfTestHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Records the microphone and system audio for 3 seconds, shows both levels, then plays the mix back." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同时录麦克风与系统声音 3 秒，显示两路电平，再回放混音。" } } } },
    "meeting.settings.hotkeyHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "None of these are set out of the box; set them here or under Shortcuts. Start Free Listening shares the former Live Translate shortcut." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全部出厂不绑定，在这里或「快捷键」页设置。「开始自由听译」与原实时翻译共用一个快捷键。" } } } },
    "dictation.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音听写" } } } },
    "dictation.bar.cancel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cancel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消" } } } },
    "dictation.bar.copied" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied — press ⌘V to paste" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制，⌘V 粘贴" } } } },
    "dictation.bar.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制" } } } },
    "dictation.bar.inserted" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Inserted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已插入" } } } },
    "dictation.bar.nothingHeard" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Didn't catch anything" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有听到内容" } } } },
    "dictation.bar.placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start talking…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请开始说话…" } } } },
    "dictation.bar.placeholderStream" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start talking — pause after a sentence to type it in…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请开始说话，说完一句停一下就上屏…" } } } },
    "dictation.bar.polishing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Polishing with AI…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在 AI 润色…" } } } },
    "dictation.bar.recognizing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognizing…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在识别…" } } } },
    "dictation.bar.position.caret" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next to the cursor" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "光标旁" } } } },
    "dictation.bar.position.bottom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom of the screen" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕底部" } } } },
    "dictation.collect.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长听写" } } } },
    "dictation.collect.clear" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空" } } } },
    "dictation.collect.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制" } } } },
    "dictation.collect.insert" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "插入" } } } },
    "dictation.collect.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束" } } } },
    "dictation.collect.resume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Dictating" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续听写" } } } },
    "dictation.collect.finishing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Finishing the last part…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在收尾最后一段…" } } } },
    "dictation.collect.paused" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stopped — edit, then insert or copy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停止，可编辑后插入或复制" } } } },
    "dictation.collect.placeholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start talking — what you say shows up here, a part at a time." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始说话吧，说的话会一段段出现在这里。" } } } },
    "dictation.collect.polishing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Polishing…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "润色中…" } } } },
    "dictation.error.noInputDevice" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No microphone available." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可用的麦克风。" } } } },
    "dictation.error.unavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech recognition isn't available right now. Check your network, or turn on Dictation in System Settings → Keyboard." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音识别暂时不可用。检查一下网络，或在「系统设置 → 键盘」里开启听写。" } } } },
    "dictation.hint.release" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Release to finish" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "松开结束" } } } },
    "dictation.hint.pressAgain" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Press again to finish" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "再按一次结束" } } } },
    "dictation.hint.autoStop %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stops after %llds of silence" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安静 %lld 秒结束" } } } },
    "dictation.hint.esc" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Esc to cancel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Esc 取消" } } } },
    "dictation.history.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation History" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写历史" } } } },
    "dictation.history.search" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Search" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "搜索" } } } },
    "dictation.history.clear" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear All" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空" } } } },
    "dictation.history.clearConfirm" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear all dictation history?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空全部听写历史？" } } } },
    "dictation.history.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制" } } } },
    "dictation.history.insert" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert again" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "再次插入" } } } },
    "dictation.history.delete" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "dictation.history.disabledNote" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation history is off — new dictations aren't saved (turn it on in Settings → Dictation)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写历史已关闭，新的听写不会保存（在 设置 → 语音听写 里打开）。" } } } },
    "dictation.history.empty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No dictations yet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有听写记录" } } } },
    "dictation.history.noMatch" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No matching dictations" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有匹配的记录" } } } },
    "dictation.hotkey.hold" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold to Talk" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按住说话" } } } },
    "dictation.hotkey.holdHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold the keys and talk; release to type it into the current text field. Regular shortcuts and F1–F12 work; a single modifier key (like right ⌥) isn't supported yet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按住说话，松开后写进当前输入框。支持普通组合键与 F1–F12（单独一个修饰键如右 ⌥ 暂不支持）。" } } } },
    "dictation.hotkey.toggle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start / Stop Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始 / 结束听写" } } } },
    "dictation.hotkey.toggleHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Press once to start. Each sentence is typed into the current text field as soon as you pause, so you can keep talking; press again, or stay quiet for a while, to stop." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按一下开始；每说完一句停一下，这句就写进当前输入框，可以一直说下去；再按一下或安静一阵后结束。" } } } },
    "dictation.hotkey.long" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长听写" } } } },
    "dictation.hotkey.longHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keeps listening until you stop. Text collects in a panel you can edit, then insert or copy in one go." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "持续识别直到手动结束；文字先进收集面板，可编辑，再整段插入或复制。" } } } },
    "dictation.insert.auto" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动" } } } },
    "dictation.insert.paste" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Always paste" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "总是粘贴" } } } },
    "dictation.language.auto" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic (Chinese / English)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动（中英自动判别）" } } } },
    "dictation.language.autoPair %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto: %1$@ / %2$@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动：%1$@ / %2$@" } } } },
    "dictation.language.chinese" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "中文" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中文" } } } },
    "dictation.language.english" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "English" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "English" } } } },
    "dictation.language.follow %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Follow Live Translate (now %@)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跟随实时翻译（当前：%@）" } } } },
    "dictation.menu.start" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始听写" } } } },
    "dictation.menu.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束听写" } } } },
    "dictation.menu.long" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long Dictation…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长听写…" } } } },
    "dictation.menu.longStop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Long Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束长听写" } } } },
    "dictation.menu.longResume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume Long Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续长听写" } } } },
    "dictation.menu.copyLast" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy Last Dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制上一次听写" } } } },
    "dictation.menu.history" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation History…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写历史…" } } } },
    "dictation.pause.off" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关" } } } },
    "dictation.pause.seconds %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld seconds" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 秒" } } } },
    "dictation.permission.microphone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风" } } } },
    "dictation.permission.speech" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech Recognition" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音识别" } } } },
    "dictation.permission.accessibility" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能" } } } },
    "dictation.permission.granted" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Granted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已授权" } } } },
    "dictation.permission.missing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not granted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未授权" } } } },
    "dictation.permission.open" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "去设置" } } } },
    "dictation.polish.off" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关" } } } },
    "dictation.polish.all" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All apps" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有 App" } } } },
    "dictation.polish.apps" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only these apps" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅这些 App" } } } },
    "dictation.polish.appsEmpty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No apps yet. Add the ones that should get polished text (documents, mail); chats can stay as spoken." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有 App。把要润色的加进来（比如文档、邮件；聊天可以保持原样）。" } } } },
    "dictation.polish.addApp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add App…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加 App…" } } } },
    "dictation.polish.removeApp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移除" } } } },
    "dictation.polish.modelTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Polishing model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "润色模型" } } } },
    "dictation.polish.notInstalledHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI polish runs on a local model, the same one Live Translate uses to fix recognition errors. Download it once; nothing leaves this Mac." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 润色用本地模型（与实时翻译纠正识别错字的是同一个），下载一次即可，内容不出本机。" } } } },
    "dictation.polish.installedHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installed. Polishing runs on this Mac." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已安装，润色在本机完成。" } } } },
    "dictation.reason.secureInput" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A password field is active, so it wasn't pasted" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在输入密码，不自动粘贴" } } } },
    "dictation.reason.noAccessibility" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Needs Accessibility permission to type for you" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要辅助功能权限才能直接输入" } } } },
    "dictation.reason.noTextFocus" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "There's no text field to type into" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可输入的地方" } } } },
    "dictation.reason.busy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The clipboard was busy, so it was copied instead" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "剪贴板正忙，改为复制" } } } },
    "dictation.reason.noTarget" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The app you came from is gone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原来的 App 已经不在了" } } } },
    "dictation.route.onDevice %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: recognized on this Mac — the audio never leaves it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@：本机识别，声音不出这台 Mac。" } } } },
    "dictation.route.noModel %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: no on-device model on this Mac, so it goes through Apple's servers. Add the language in System Settings → Keyboard → Dictation to get one." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@：这台 Mac 没有本机模型，会走 Apple 服务器识别（在「系统设置 → 键盘 → 听写」里加上这种语言可下载本机模型）。" } } } },
    "dictation.route.server %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: through Apple's servers (“Prefer on-device recognition” is off)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@：走 Apple 服务器识别（已关闭「优先设备端识别」）。" } } } },
    "dictation.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Talk instead of typing: what you say goes straight into the text field you're in. Three ways to start, each with its own shortcut below:" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用说的代替打字：说的话直接写进你正在用的输入框。三种唤起方式，快捷键在下面设：" } } } },
    "dictation.settings.modeHold" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold to Talk — hold the keys, talk, release to type it in." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按住说话：按住快捷键说话，松开就上屏。" } } } },
    "dictation.settings.modeToggle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start / Stop Dictation — press once to start; each sentence goes in as soon as you pause, so you can keep talking. Press again or stay quiet to stop. Also in the menu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始 / 结束听写：按一下开始，每说完一句停一下就上屏，可以一直说；再按一下或安静一阵后结束。菜单里也有。" } } } },
    "dictation.settings.modeLong" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long Dictation — keeps listening; text collects in a panel you can edit, then insert or copy in one go." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长听写：一直听到你结束；文字先进收集面板，改好再整段插入或复制。" } } } },
    "dictation.settings.hotkeyHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start / Stop Dictation ships as ⌥Space; the other two are unassigned out of the box — change any of them here or on the Shortcuts page. Hold to Talk supports regular shortcuts and F1–F12; a single modifier key (like right ⌥) isn't supported yet. While dictating, Esc cancels (needs Accessibility)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「开始 / 结束听写」出厂是 ⌥Space，另外两个出厂不绑定，都可以在这里或「快捷键」页改。按住说话支持普通组合键与 F1–F12（单独一个修饰键如右 ⌥ 暂不支持）。听写中按 Esc 取消（需要辅助功能权限）。" } } } },
    "dictation.settings.recognitionSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognition" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别" } } } },
    "dictation.settings.language" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Language" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别语言" } } } },
    "dictation.settings.languageHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic listens in the main language first (English if your system is in English, otherwise Chinese); when a passage looks unsure, it re-checks the recording in the other language and keeps the better one. Start / Stop Dictation and Long Dictation decide per sentence, so you can switch languages between sentences. Chinese recognition already picks up common English words mixed in." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动：先按主语言识别（系统是英文就先英文，否则先中文），一段拿不准时用录音换另一种语言再认一遍，取更像的那份。「开始 / 结束听写」与长听写按句判，可以一句中文一句英文。中文识别本身就能认出夹杂的常见英文词。" } } } },
    "dictation.settings.pause" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop after silence" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安静多久自动结束" } } } },
    "dictation.settings.pauseHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For Start / Stop Dictation: each sentence goes in after a short pause (about a second); staying quiet this long ends the dictation." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于「开始 / 结束听写」：每句说完停一下（约 1 秒）就上屏；一直安静这么久，就结束这次听写。" } } } },
    "dictation.settings.onDevice" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prefer on-device recognition" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "优先设备端识别" } } } },
    "dictation.settings.textSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Text" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文本处理" } } } },
    "dictation.settings.voiceCommands" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Voice commands" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音指令" } } } },
    "dictation.settings.voiceCommandsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Say 「换行 / 新的一行」 or “new line” for a line break, 「新段落」 or “new paragraph” for a blank line, 「句号 / 逗号 / 问号 / 感叹号」 for punctuation, and 「删除上一句」 or “delete last sentence” to drop the previous sentence of this dictation (if it's already typed in, it's backspaced away — only text this dictation typed into the current app)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说「换行 / 新的一行 / new line」换行，「新段落 / new paragraph」空一行，「句号 / 逗号 / 问号 / 感叹号」打对应标点，「删除上一句 / delete last sentence」删掉这次听写里的上一句（已经上屏的用退格删，只删这次听写在当前 App 里输入的字）。" } } } },
    "dictation.settings.fillerFilter" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Filter filler words" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "口头禅过滤" } } } },
    "dictation.settings.fillerFilterHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drops 嗯 / 呃 / 额 / 唔, a stray 「啊」 or 「那个」 at the start of a sentence, um / uh / er / hmm, and stutters like 「我我我」 or “the the”. Conservative: when unsure, the words stay." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "去掉「嗯、呃、额、唔」、句首孤立的「啊、那个」、um / uh / er / hmm，以及「我我我」「the the」这样连说的字词。保守处理：拿不准的不动。" } } } },
    "dictation.settings.polishSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI Polish" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 润色" } } } },
    "dictation.settings.polish" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Polish into written text" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "整理成书面语" } } } },
    "dictation.settings.polishHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A local model tidies spoken text into written text (drops filler, smooths sentences) without adding or removing information. Hold to Talk polishes the whole passage before it goes in (up to 8 seconds; on timeout the original goes in); Start / Stop Dictation and Long Dictation polish sentence by sentence, adding a second or two to each." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本地模型把口语整理成书面语（去口水、顺句子），不增删信息。按住说话等整段定稿后润色再上屏（最多 8 秒，超时上原文）；「开始 / 结束听写」与长听写逐句润色，每句多等一两秒。" } } } },
    "dictation.settings.insertSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Typing It In" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "插入" } } } },
    "dictation.settings.insertMode" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Insert method" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "插入方式" } } } },
    "dictation.settings.insertHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic: native text fields get the text written in directly; where that doesn't work (Electron apps, terminals, web pages) it pastes through the clipboard and puts your clipboard back — this never shows up in clipboard history. In a password field, or with nowhere to type, it's only copied, for you to press ⌘V. Always paste: always go through the clipboard." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动：原生 App 的输入框直接写进去；写不进去的（Electron、终端、网页）借剪贴板粘贴，用完还原，不进剪贴板历史。在密码框里、或没有可输入的地方时，只复制到剪贴板，自己按 ⌘V。总是粘贴：一律借剪贴板粘贴。" } } } },
    "dictation.settings.barSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording Bar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录音条" } } } },
    "dictation.settings.barPosition" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Position" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "位置" } } } },
    "dictation.settings.sounds" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Play start and end sounds" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始与结束提示音" } } } },
    "dictation.settings.historySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "History" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写历史" } } } },
    "dictation.settings.historyEnabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep dictation history" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存听写历史" } } } },
    "dictation.settings.historyLimit %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep the last %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留最近 %lld 条" } } } },
    "dictation.settings.openHistory" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation History…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写历史…" } } } },
    "dictation.settings.clearHistory" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear History…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空历史…" } } } },
    "dictation.settings.historyCount %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld saved" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已存 %lld 条" } } } },
    "dictation.settings.historyHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only the text, time and target app are kept — never audio — in ~/Library/Application Support/Baobox/Dictation/history.json." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只存文字、时间和目标 App，不存音频，位置在 ~/Library/Application Support/Baobox/Dictation/history.json。" } } } },
    "dictation.settings.glossarySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Glossary" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "术语表" } } } },
    "dictation.settings.glossaryCount %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld terms (shared with Live Translate)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "共 %lld 条（与实时翻译共用）" } } } },
    "dictation.settings.editGlossary" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Edit in Live Translate…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "去实时翻译编辑…" } } } },
    "dictation.settings.glossaryHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Names and product terms listed here are recognized more accurately." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "人名、产品名等专有名词放进术语表，识别更准。" } } } },
    "dictation.settings.permissionsSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permissions" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "权限" } } } },
    "dictation.settings.permissionsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Asked for the first time you dictate — nothing is requested in advance. Microphone and Speech Recognition are needed to listen; Accessibility to type into text fields, paste, and catch Esc." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第一次用时才按需申请，不预先弹窗。麦克风、语音识别用来听；辅助功能用来写进输入框、模拟粘贴和拦截 Esc。" } } } },
    "dictation.toast.busy %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ is using the microphone. Stop it before dictating." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在%@，先停止再听写" } } } },
    "dictation.toast.copiedLast" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied the last dictation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制上一次听写" } } } },
    "dictation.toast.failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dictation stopped" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "听写中断了" } } } },

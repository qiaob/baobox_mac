    "annotation.save" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save ⌥⏎" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存 ⌥⏎" } } } },
    "annotation.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy & finish ⏎" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制并完成 ⏎" } } } },

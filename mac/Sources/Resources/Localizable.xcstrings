    "meeting.menu.subtitlesOff" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hide Subtitles" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "收起字幕" } } } },
    "meeting.menu.openLibrary" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Meeting Library in Finder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Finder 中打开会议库" } } } },
    "meeting.menu.settings" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Meeting Settings…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议设置…" } } } },
    "meeting.hotkey.startOnline" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start / End Online Meeting Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始 / 结束线上会议记录" } } } },
    "meeting.hotkey.startOnlineHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts recording an online meeting; while recording, ends it and writes the minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲时开始线上会议记录，记录中按一下结束并生成纪要" } } } },
    "meeting.hotkey.startOffline" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start In-Person Meeting Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始线下会议记录" } } } },
    "meeting.hotkey.mark" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mark Key Point" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "标记重点" } } } },
    "meeting.hotkey.markHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Works while recording a meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议记录中有效" } } } },
    "meeting.hotkey.notes" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Notes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开速记" } } } },
    "meeting.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record online meetings (microphone + system audio, labeled Me / Them) or in-person meetings (microphone only), then write minutes with local AI. Free listening is the former Live Translate. Everything stays on this Mac." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录线上会议（麦克风 + 系统声音，标「我 / 对方」）或线下会议（仅麦克风），会后用本地 AI 生成纪要；自由听译就是原来的实时翻译。全部只存在这台 Mac 上。" } } } },
    "meeting.settings.recordSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录" } } } },
    "meeting.settings.defaultType" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default type when starting manually" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "手动开始时的默认类型" } } } },
    "meeting.settings.template" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Minutes template" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纪要模板" } } } },
    "meeting.settings.templateHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every template writes Summary, Decisions, Action items and Highlights; Stand-up, 1:1 and Interview change what goes into each. Free listening keeps its key points / decisions / to-dos." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "各模板都按「摘要、决议、行动项、重点」四节写，站会 / 1:1 / 面试换各节的侧重；自由听译仍是要点 / 结论 / 待办。" } } } },
    "meeting.settings.retention" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep meetings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留时长" } } } },
    "meeting.settings.retentionHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Meetings older than this go to the Trash the next time Baobox starts." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "超过保留时长的会议在下次启动 Baobox 时移到废纸篓。" } } } },
    "meeting.settings.library" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Meeting library" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议库" } } } },
    "meeting.settings.libraryHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One folder per meeting: meeting.md (minutes, notes, transcript) and meta.json (details and action items). Transcripts from the old Live Translate folder were imported by reference and left in place." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每场一个目录：meeting.md（纪要、速记、转录）与 meta.json（元信息与行动项）。原实时翻译文件夹里的旧记录已按引用导入，文件原地不动。" } } } },
    "meeting.settings.hotkeySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shortcuts" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快捷键" } } } },
    "meeting.settings.subtitlesSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Subtitles & Interpreting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "字幕与同传" } } } },
    "meeting.settings.subtitlesIntro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Below are the former Live Translate settings, unchanged. Free listening uses all of them; meetings use the speech language and AI correction, plus translation, read-aloud and the subtitle bar once you turn on Subtitles." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下面是原实时翻译的全部设置（原样平移）。自由听译全都照它们来；会议用其中的说话语言与 AI 纠错，打开「字幕」后再加上翻译、朗读与字幕条。" } } } },
    "livetranslate.mergedName" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Subtitles & Interpreting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "字幕与同传" } } } },
    "livetranslate.menu.merged" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Now part of Meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已并入「会议」" } } } },
    "livetranslate.settings.merged" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live Translate is now part of Meeting: these settings also appear under Meeting › Subtitles & Interpreting, and from the next version only there." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时翻译已并入「会议」：这些设置也在 会议 › 字幕与同传 里，下个版本起只在那里。" } } } },
    "livetranslate.settings.openMeeting" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Meeting Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开会议设置" } } } },
    "livetranslate.status.engineCloud %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cloud: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "云端：%@" } } } },

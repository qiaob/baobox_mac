    "claudecode.settings.config.privacyHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Maps to env flags in settings.json; unchecking removes only that key and leaves your other env vars intact." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "映射 settings.json 的 env 开关；取消勾选仅移除对应键，不影响你自设的其他环境变量。" } } } },
    "claudecode.settings.config.commit" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Commit attribution" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提交署名" } } } },

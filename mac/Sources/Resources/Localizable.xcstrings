    "meeting.bar.micMute" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone (your voice) · click to stop recording it (people in the meeting still hear you)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风（你的声音）· 点一下不录（会议里别人照样听得到你）" } } } },
    "meeting.bar.micUnmute" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone muted: your voice isn't being recorded · click to record it again" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风已静音，没在录你的声音 · 点一下恢复" } } } },
    "meeting.bar.systemMute" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System audio (the other side) · click to stop recording it" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统声音（对方的声音）· 点一下不录" } } } },
    "meeting.bar.systemUnmute" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System audio muted: the other side isn't being recorded · click to record it again" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统声音已静音，没在录对方的声音 · 点一下恢复" } } } },

    "meeting.bar.subtitlesHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show the subtitle bar with translations (languages and read-aloud: Settings › Meeting › Subtitles & Interpreting)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开字幕条与译文（语言、朗读等见 设置 › 会议 › 字幕与同传）" } } } },

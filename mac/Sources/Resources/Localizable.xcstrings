    "focus.hotkey.focus" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start / Pause Focus" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始 / 暂停专注" } } } },
    "focus.hotkey.focusHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts a focus session with the default length; pauses or resumes one in progress" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲时按默认时长开始专注，专注中按一下暂停 / 继续" } } } },
    "focus.hotkey.breakNow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a Break Now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在休息" } } } },
    "focus.toast.started %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focusing for %lld minutes — go!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注 %lld 分钟，开始！" } } } },
    "focus.toast.staleDone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your last focus round was completed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上一轮专注已完成" } } } },
    "focus.toast.breakInFocus" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This focus round isn't over yet — take a break when it ends" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这一轮专注还没结束，结束后再休息" } } } },
    "focus.toast.alreadyOnBreak" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "You're already on a break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已经在休息了" } } } },
    "focus.focusDone.title %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus round %lld done!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %lld 轮专注完成！" } } } },
    "focus.focusDone.shortBody %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take %lld minutes — I'll call you back." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息 %lld 分钟，到点叫你。" } } } },
    "focus.focusDone.longMessage %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Round %lld done. Step away from the screen and rest for a while." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %lld 轮完成，离开屏幕好好歇一会儿。" } } } },
    "focus.style.nudge" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Light nudge" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻提醒" } } } },
    "focus.summary.nudge" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Light nudge" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻提醒" } } } },
    "focus.nudge.eyeTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Look into the distance for 20 seconds" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "看看远处 20 秒" } } } },
    "focus.nudge.eyeBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest your eyes on something about 6 m away." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "看看 6 米外的东西，让眼睛放松一下" } } } },
    "focus.fold.water" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "have some water" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "喝口水" } } } },
    "focus.fold.stand" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "get up and walk around" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "起来走走" } } } },
    "focus.bubble.standWaterTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Get up and have some water" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "起来走走，喝口水" } } } },
    "focus.bubble.standWaterBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand up and move for a couple of minutes, and grab a glass of water on the way." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "站起来活动两分钟，顺手倒杯水。" } } } },
    "focus.settings.minSpacing %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "At least %lld minutes between reminders" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "两次提醒至少间隔 %lld 分钟" } } } },
    "focus.settings.rhythmHint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders follow one rhythm instead of popping up on their own: anything else due soon is folded into the same reminder; a small one waits when a bigger break is less than 10 minutes away; a break also counts as getting up, drinking water and resting your eyes; and two reminders are never closer than the spacing above (fixed-time reminders such as medicine are never moved)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒按一个统一的节拍来，不再各自弹：快到点的事并进同一次提醒；大休息 10 分钟内就到时，小的先等着一起说；休息一次也算起身、喝水、护眼都做过了；两次提醒之间至少隔上面这么久（每天固定时刻的提醒，比如吃药，不挪）。" } } } },
    "focus.break.confirmTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break's over: confirm it's you" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息结束，确认是你本人" } } } },
    "focus.break.confirmSkipTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skipping the break: confirm it's you" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过休息，确认是你本人" } } } },
    "focus.break.confirmHint %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Touch ID to come back. If no one confirms in %lld s, the screen locks." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按一下 Touch ID 回来；%lld 秒内没人确认就锁屏" } } } },
    "focus.break.confirmMini" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for you to confirm" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等你回来确认" } } } },
    "focus.break.confirmReason" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "end the break (confirm it's you)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束休息（确认是你本人）" } } } },
    "focus.lock.failedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't lock the screen after the break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息结束时没能锁屏" } } } },
    "focus.lock.failedBody" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baobox locks the screen by pressing ⌃⌘Q for you, which needs the Accessibility permission." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baobox 是替你按 ⌃⌘Q 锁屏的，需要辅助功能权限。" } } } },
    "focus.settings.confirmIdentity" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Confirm It's Me Before a Full-Screen Break Goes Away" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "撤下全屏休息画面前确认是我本人" } } } },
    "focus.settings.confirmIdentityHint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "However the full-screen break ends (time's up, hold to skip, or ending it from the menu), the screen stays covered until you confirm with Touch ID right on the break card. If no one confirms within 30 seconds (you're away), or this Mac has no Touch ID, the Mac locks itself and you come back with your password. If Baobox quits or something goes wrong while the screen is covered, it locks the screen before the cover goes away." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全屏休息画面不管怎么结束（到点、长按跳过、从菜单结束），遮罩都先留着，等你在卡片上按 Touch ID 确认；30 秒内没人确认（你不在）、或这台 Mac 没有 Touch ID，就自动锁屏，用密码从锁屏界面回来。遮罩在场时 Baobox 退出或出了异常，也会先锁屏再撤遮罩。" } } } },
    "focus.alsoLine %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "顺便：%@" } } } },
    "focus.listSeparator" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : ", " } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "、" } } } },
    "focus.breakDone.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break's over!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息好啦！" } } } },
    "focus.breakDone.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ready for the next round?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始下一轮专注吗？" } } } },
    "focus.action.nextRound" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "One More Round" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "再来一轮" } } } },
    "focus.action.endCycle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束" } } } },
    "focus.action.resume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续" } } } },

    "screenshot.ocr.result.recognizing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognizing…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别中…" } } } },

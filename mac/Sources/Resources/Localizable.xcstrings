    "claudecode.settings.config.guardEnabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable dangerous-command guard" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用危险命令卫士" } } } },
    "claudecode.settings.config.guardHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installs a PreToolUse(Bash) hook; matching commands are blocked and the reason is fed back to Claude. A blacklist guards against slips, not deliberate bypass." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装 PreToolUse(Bash) hook，命中规则的命令会被阻止并把原因反馈给 Claude。黑名单只防手滑，不防刻意绕过。" } } } },
    "claudecode.settings.config.guardCustom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom rules (regex)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义规则（正则）" } } } },
    "claudecode.settings.config.guardRulePlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "ERE regex matched against the command JSON" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "ERE 正则，匹配整行命令 JSON" } } } },
    "claudecode.settings.config.guardReset" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore default rules" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复默认规则" } } } },
    "claudecode.settings.config.privacy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私" } } } },
    "claudecode.settings.config.privacy.telemetry" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable telemetry" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭遥测" } } } },
    "claudecode.settings.config.privacy.errorReporting" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disable error reporting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭错误上报" } } } },

    "focus.rest.longTitle %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long break · %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长休息 · %lld 分钟" } } } },
    "focus.break.done" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break's over!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息好啦！" } } } },
    "focus.break.skip" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过" } } } },
    "focus.break.holdToSkip" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold 3 s to skip" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长按 3 秒跳过" } } } },
    "focus.break.mini" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On a break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息中" } } } },
    "focus.break.nudge" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not done resting yet~" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没休息完哦～" } } } },
    "focus.break.almost" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Almost there!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "马上就好啦！" } } } },
    "focus.break.pokeLine %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld more min~" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还要 %lld 分钟哦～" } } } },
    "focus.preview.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview · Take a break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预览 · 休息一下" } } } },
    "focus.preview.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This is what a break looks like. It ends in 10 seconds." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息画面就长这样，10 秒后自动结束。" } } } },
    "focus.preview.bubbleMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This is how Relaxed reminds you: the pet pops up a bubble." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻松档到点时就是这样：宠物冒个气泡提醒你。" } } } },
    "focus.preview.notificationMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The pet is off, so Relaxed reminds you with a system notification like this one." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宠物关着，轻松档就用这样的系统通知提醒你。" } } } },
    "focus.preset.water" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drink Water" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "喝水" } } } },
    "focus.preset.stand" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand Up" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "站立活动" } } } },
    "focus.preset.eye" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye Rest 20-20-20" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "护眼 20-20-20" } } } },
    "focus.preset.break" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "整段休息" } } } },
    "focus.preset.custom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom Reminder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义提醒" } } } },
    "focus.newItemName" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "New Reminder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "新提醒" } } } },
    "focus.summary.every %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每 %lld 分钟" } } } },
    "focus.summary.daily %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Daily at %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每天 %@" } } } },
    "focus.summary.bubble" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pet reminder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宠物提醒" } } } },
    "focus.summary.rest %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息 %@" } } } },
    "focus.duration.seconds %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld s" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 秒" } } } },
    "focus.duration.minutes %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分钟" } } } },
    "focus.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A focus timer and health reminders in one tool. Reminders come from the desktop pet; when it's time for a break, the pet walks to the middle of the screen, grows big, and rests with you." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注计时与健康提醒合在一起：提醒由桌面宠物送来；到了该休息的时候，宠物走到屏幕中间变大，陪你一起休息。" } } } },
    "focus.settings.focusSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注" } } } },
    "focus.settings.defaultMinutes" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default length" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认时长" } } } },
    "focus.settings.minutes %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分钟" } } } },
    "focus.settings.shortBreak %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Short break: %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "短休息：%lld 分钟" } } } },
    "focus.settings.longBreak %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long break: %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长休息：%lld 分钟" } } } },
    "focus.settings.longEvery %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Long break every %lld rounds" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每 %lld 轮来一次长休息" } } } },
    "focus.settings.autoNext" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start the next round automatically after a break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息结束后自动开始下一轮" } } } },
    "focus.settings.focusHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "While focusing, the pet sleeps, other notifications wait, and health reminders are held until the focus ends. Focus sessions of 50 minutes or more are followed by a long break." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注中宠物睡下、其他通知攒着、健康提醒顺延到专注结束。50 分钟以上的专注结束后直接接长休息。" } } } },
    "focus.settings.remindersSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒项" } } } },
    "focus.settings.remindersEnabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Health reminders" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "健康提醒" } } } },
    "focus.settings.addItem" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add Reminder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加提醒" } } } },
    "focus.settings.restorePresets" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore Presets" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复预置" } } } },
    "focus.settings.breakSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break Screen" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息画面" } } } },
    "focus.settings.strength" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Strength" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "强度" } } } },
    "focus.strength.relaxed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Relaxed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻松" } } } },
    "focus.strength.standard" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Standard" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "标准" } } } },
    "focus.strength.strict" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Strict" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "严格" } } } },
    "focus.strength.relaxedHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When it's time, the pet just pops up a bubble where it is. You can postpone or ignore it; nothing interrupts your work." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "到点时宠物在原地冒个气泡提醒你休息，可以推迟或忽略，不打断手上的事。" } } } },
    "focus.strength.standardHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The pet walks to the middle of the screen and grows big; all screens dim and keyboard and mouse are paused. No postponing — skipping takes a 3-second hold." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宠物走到屏幕中间变大，所有屏幕变暗并暂停键鼠操作；不能推迟，长按 3 秒才能跳过。" } } } },
    "focus.strength.strictHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Like Standard, plus the background is blurred so nothing on screen is readable — just rest." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在标准的基础上把背景也模糊掉，屏幕上的内容都看不清，专心休息。" } } } },
    "focus.settings.maxSnoozes %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Postpone up to %lld times per break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次休息最多推迟 %lld 次" } } } },
    "focus.settings.backdrop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Background when the pet is off (Standard)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宠物关闭时的背景（标准档）" } } } },
    "focus.backdrop.teal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Teal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "青绿" } } } },
    "focus.backdrop.dusk" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Dusk" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暮色" } } } },
    "focus.backdrop.forest" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Forest" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "森林" } } } },
    "focus.backdrop.image" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Image…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自选图片" } } } },
    "focus.settings.noImage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No image chosen" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没选图片" } } } },
    "focus.settings.chooseImage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择…" } } } },
    "focus.settings.backdropHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With the pet on, Standard dims the screen and the pet keeps you company; with the pet off, Standard fills the screen with this background. Strict always blurs. Pet reminders become system notifications with the same buttons while the pet is off." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宠物开着时标准档只把屏幕调暗、由宠物陪你；宠物关闭时标准档用这里的背景铺满屏幕。严格档始终是模糊。宠物关闭时，宠物提醒改成系统通知，按钮照样能点。" } } } },
    "focus.settings.preview" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "预览效果" } } } },
    "focus.settings.workSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Work Hours" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "工作时间" } } } },
    "focus.settings.workStart" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始" } } } },
    "focus.settings.workEnd" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ends" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束" } } } },
    "focus.settings.workdaysOnly" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Workdays only" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅工作日" } } } },
    "focus.settings.workHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders set to “Work hours only” fire only in this window." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "勾了「仅工作时间」的提醒只在这个时段里提醒。" } } } },
    "focus.settings.avoidSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Do Not Disturb" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动避让" } } } },
    "focus.settings.avoidHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders wait while you're in a meeting (microphone in use), using a full-screen app, recording the screen with Baobox, or while the pet is quiet. A break held back for over 45 minutes turns into a gentle pet reminder instead of covering the screen." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开会（麦克风在用）、前台全屏、Baobox 录屏中、宠物「安静一下」时，提醒自动顺延；顺延超过 45 分钟的休息改成宠物提醒，不再突然盖屏。" } } } },
    "focus.settings.item.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Name" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "名称" } } } },
    "focus.settings.item.schedule" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Repeat" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "计时" } } } },
    "focus.schedule.interval" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every few minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每隔一段时间" } } } },
    "focus.schedule.daily" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Daily at a set time" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每天固定时刻" } } } },
    "focus.settings.item.interval %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每 %lld 分钟" } } } },
    "focus.settings.item.clock" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Count" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "计时口径" } } } },

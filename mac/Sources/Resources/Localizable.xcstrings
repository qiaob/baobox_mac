    "focus.status.remindersOff" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Health reminders off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "健康提醒已关闭" } } } },
    "focus.status.offToday" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders off for today" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "今天的提醒已关闭" } } } },
    "focus.status.pausedUntil %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reminders paused until %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提醒已暂停，%@ 恢复" } } } },
    "focus.status.noReminders" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No reminders enabled" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有开启的提醒" } } } },
    "focus.status.nextNow %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next: %@ · now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一个：%@ · 马上" } } } },
    "focus.status.next %@ %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next: %@ · in %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下一个：%@ · %lld 分钟后" } } } },
    "focus.hotkey.focus" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start / Pause Focus" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始 / 暂停专注" } } } },
    "focus.hotkey.focusHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starts a focus session with the default length; pauses or resumes one in progress" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "空闲时按默认时长开始专注，专注中按一下暂停 / 继续" } } } },
    "focus.hotkey.breakNow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take a Break Now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在休息" } } } },
    "focus.toast.started %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focusing for %lld minutes — go!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注 %lld 分钟，开始！" } } } },
    "focus.toast.staleDone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your last focus round was completed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上一轮专注已完成" } } } },
    "focus.focusDone.title %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus round %lld done!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %lld 轮专注完成！" } } } },
    "focus.focusDone.shortBody %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Take %lld minutes — I'll call you back." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息 %lld 分钟，到点叫你。" } } } },
    "focus.focusDone.longMessage %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Round %lld done. Step away from the screen and rest for a while." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "第 %lld 轮完成，离开屏幕好好歇一会儿。" } } } },
    "focus.alsoLine %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "顺便：%@" } } } },

    "ai.settings.privacy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only features set to a cloud model send anything, and only the text they need (each feature says what it sends). Everything else stays on this Mac. API keys are kept in the Keychain, never in preferences or logs." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有选了云端模型的功能才会发，也只发它需要的文字（每个功能下面写着发什么）；其余都在本机处理。API Key 存在钥匙串里，不进偏好设置、不写日志。" } } } },
    "ai.settings.privacySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "What gets sent" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会发出去什么" } } } },
    "ai.settings.saveKey" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存" } } } },

    "claudecode.settings.config.allowList" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow rules" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "allow 规则" } } } },
    "claudecode.settings.config.denyList" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deny rules" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "deny 规则" } } } },

    "claudecode.settings.config.preset.gitRead" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Git read-only (status / log / diff)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Git 只读（status / log / diff）" } } } },
    "claudecode.settings.config.preset.gitWrite" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Git write (add / commit / push)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Git 写入（add / commit / push）" } } } },
    "claudecode.settings.config.preset.fileRead" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File read" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件读取" } } } },
    "claudecode.settings.config.presetsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Checking a group adds its commands to permissions.allow; unchecking removes them all." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "勾选后把对应命令加入 permissions.allow；取消则移除该组全部规则。" } } } },

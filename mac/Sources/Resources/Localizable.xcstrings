    "permission.accessibility.desc" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lets clipboard items paste into the frontmost app automatically. Without it, items are only copied." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于选中剪贴板历史后自动粘贴到当前 App。未授权时降级为仅复制。" } } } },
    "onboarding.windowTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Welcome to Baobox" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "欢迎使用 Baobox" } } } },
    "onboarding.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Two System Permissions Needed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要两项系统权限" } } } },
    "onboarding.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Everything Baobox records stays on this Mac — nothing is uploaded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baobox 的所有数据仅保存在本机，不会上传。" } } } },
    "onboarding.screen.desc" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Needed to capture the screen. macOS requires restarting Baobox after enabling." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于截取屏幕内容。系统限制：开启后需重启 Baobox 才生效。" } } } },
    "onboarding.enabledRestart" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enabled — Restart Now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已开启，立即重启" } } } },
    "onboarding.openSettings" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开系统设置" } } } },

    "netcapture.empty.waiting" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Waiting for traffic…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "等待流量…" } } } },
    "netcapture.empty.step1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start the proxy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启代理" } } } },
    "netcapture.empty.step2 %@ %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Set the device proxy to %@:%lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "设备代理设为 %@:%lld" } } } },

    "focus.rest.eyeMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Rest your eyes on something far away for 20 seconds." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "看远处的东西 20 秒，让眼睛放松一下。" } } } },

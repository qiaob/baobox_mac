    "livetranslate.bar.close" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Live Translate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止实时翻译" } } } },
    "livetranslate.display.both" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original + translation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原文 + 译文" } } } },
    "livetranslate.display.translation" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation only" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅译文" } } } },
    "livetranslate.display.original" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Original only" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅原文" } } } },
    "livetranslate.error.noInputDevice" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No microphone found. Connect one or pick it in System Settings › Sound › Input." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有找到可用的麦克风。请连接麦克风，或在「系统设置 › 声音 › 输入」里选择。" } } } },
    "livetranslate.error.noDisplay" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No display is available to capture system audio from." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可用于采集系统声音的显示器。" } } } },
    "livetranslate.alert.speechDeniedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech Recognition Not Allowed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未允许语音识别" } } } },
    "livetranslate.alert.speechDeniedMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live Translate needs Speech Recognition to turn audio into text. Allow Baobox in System Settings › Privacy & Security › Speech Recognition." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时翻译需要语音识别权限才能把声音转成文字。请在「系统设置 › 隐私与安全性 › 语音识别」里允许 Baobox。" } } } },
    "livetranslate.alert.micDeniedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone Not Allowed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未允许使用麦克风" } } } },
    "livetranslate.alert.micDeniedMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Baobox in System Settings › Privacy & Security › Microphone, or switch the audio source to System Audio." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在「系统设置 › 隐私与安全性 › 麦克风」里允许 Baobox，或把音源切换为系统声音。" } } } },
    "livetranslate.alert.screenTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen Recording Needed for System Audio" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采集系统声音需要屏幕录制权限" } } } },
    "livetranslate.alert.screenMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS delivers system audio through screen capture. Allow Baobox in System Settings › Privacy & Security › Screen Recording, then restart Baobox." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "macOS 的系统声音经屏幕采集接口提供。请在「系统设置 › 隐私与安全性 › 屏幕录制」里允许 Baobox，然后重启 Baobox。" } } } },
    "livetranslate.alert.unavailableTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech Recognition Unavailable" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音识别不可用" } } } },
    "livetranslate.alert.unavailableMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech recognition for this language isn't available right now. Make sure Dictation is turned on in System Settings › Keyboard, and that you're online if the on-device model isn't installed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前语言的语音识别暂不可用。请确认「系统设置 › 键盘」里已打开听写；未安装本地模型时还需要联网。" } } } },
    "livetranslate.alert.audioFailedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't Start Audio Capture" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法开始采集声音" } } } },
    "livetranslate.alert.recognitionFailedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech Recognition Keeps Failing" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语音识别连续失败" } } } },
    "livetranslate.notice.needsMacOS15" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation requires macOS 15 or later; showing the original text only." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译需要 macOS 15 或更高版本，当前只显示原文。" } } } },
    "livetranslate.notice.translateFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation failed. Install English and Chinese in System Settings › General › Language & Region › Translation Languages." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译失败。请在「系统设置 › 通用 › 语言与地区 › 翻译语言」里下载英语与中文。" } } } },
    "livetranslate.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turns speech from the microphone or system audio into captions in real time, translates between English and Chinese, and shows them in a bar on screen." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把麦克风或系统声音里的语音实时转成字幕，英中互译，显示在屏幕上的一条字幕条里。" } } } },
    "livetranslate.settings.audioSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "声音" } } } },
    "livetranslate.settings.source" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio source" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音源" } } } },
    "livetranslate.settings.sourceHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone: what you or people in the room say. System audio: what your Mac plays — videos, courses, the other side of a call (needs Screen Recording permission)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风：你或现场的人说的话。系统声音：Mac 正在播放的声音 —— 视频、网课、线上会议对方的声音（需要屏幕录制权限）。" } } } },
    "livetranslate.settings.language" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Spoken language" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说话语言" } } } },
    "livetranslate.settings.onDevice" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Prefer on-device recognition" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "优先本地识别" } } } },
    "livetranslate.settings.onDeviceHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When the on-device model is available, audio never leaves your Mac. Otherwise Apple's speech service is used." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本机有本地模型时，声音不会离开这台 Mac；没有时使用 Apple 的语音识别服务。" } } } },
    "livetranslate.settings.routeHeader" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current recognition" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前识别方式" } } } },
    "livetranslate.settings.route.onDevice %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: on-device, audio stays on this Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@：本机识别，声音不离开这台 Mac" } } } },
    "livetranslate.settings.route.noModel %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: Apple's speech service (this Mac has no on-device model for it)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@：Apple 语音识别服务（这台 Mac 没有它的本地模型）" } } } },
    "livetranslate.settings.route.addLanguage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Keyboard › Dictation settings…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开「键盘 › 听写」设置…" } } } },
    "livetranslate.settings.translateSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译" } } } },
    "livetranslate.settings.translate" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate captions" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译字幕" } } } },
    "livetranslate.settings.translateHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "English is translated into Chinese and Chinese into English, on-device with Apple Translation. macOS may ask to download the language files the first time." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "英文译成中文、中文译成英文，使用系统自带的本地翻译。首次使用时系统可能会提示下载语言包。" } } } },
    "livetranslate.settings.barSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Caption Bar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "字幕条" } } } },
    "livetranslate.settings.display" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示" } } } },
    "livetranslate.settings.fontSize" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Font size" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "字号" } } } },
    "livetranslate.settings.opacity" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Background" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "背景不透明度" } } } },
    "livetranslate.settings.barHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag the bar to move it; its position is remembered. Click × on the bar to stop." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖动字幕条可移动位置，位置会被记住。点字幕条上的 × 停止。" } } } },
    "livetranslate.notice.downloadingModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Downloading the speech model (first time only)…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在下载语音模型（仅首次）…" } } } },
    "livetranslate.settings.engineAnalyzer" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses the new on-device speech engine in macOS 26: faster and more accurate, and audio never leaves your Mac. The model downloads automatically the first time." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "使用 macOS 26 新一代本地识别引擎：更快更准，声音不离开这台 Mac。首次使用自动下载语音模型。" } } } },
    "livetranslate.settings.vocabularySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom Vocabulary" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专有名词" } } } },
    "livetranslate.settings.vocabularyHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Names, products and jargon that get misheard or mistranslated. Recognition is hinted with these terms; translation uses the translation on the right, and terms without one are kept as is. Press Return to move to the next field. Changes apply right away (recognition from the next sentence). Apple's system translation engine (macOS 15+) can't use fixed translations, so there they only help recognition." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "容易听错、译错的人名、产品名、术语。识别时会提示这些词；翻译时按右边的译名翻，译名留空就保持原样不翻。回车跳到下一格。改完立即生效（识别从下一句起）。系统翻译引擎（macOS 15+）不支持指定译名，只用于识别。" } } } },
    "livetranslate.glossary.sourceHeader" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Term" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原文" } } } },
    "livetranslate.glossary.targetHeader" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate as (optional)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "译名（可留空）" } } } },
    "livetranslate.glossary.sourcePlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "e.g. Wigmore" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "例如 Wigmore" } } } },
    "livetranslate.glossary.targetPlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Empty = keep as is" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "留空 = 保持原样不翻" } } } },
    "livetranslate.glossary.add" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加" } } } },
    "livetranslate.glossary.remove" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Remove" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "livetranslate.glossary.summary %lld %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$lld terms, %2$lld with a fixed translation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "共 %1$lld 个，其中 %2$lld 个指定了译名" } } } },
    "livetranslate.glossary.overLimit %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "only the first %lld are used" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只有前 %lld 个生效" } } } },
    "notify.digest.title %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld muted notifications" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 条提醒已合并" } } } },
    "pet.bubble.more %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld more" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还有 %lld 条" } } } },
    "pet.download.error.checksum" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "File checksum mismatch" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件校验失败" } } } },
    "pet.download.error.failed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download failed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载失败" } } } },
    "pet.download.error.http %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Server returned %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器返回 %lld" } } } },
    "pet.hotkey.toggle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show / Hide Pet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示 / 隐藏宠物" } } } },
    "pet.line.feed1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Yum!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好吃！" } } } },
    "pet.line.feed2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Thank you~" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "谢谢投喂～" } } } },
    "pet.line.highFive1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "High five!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "耶！" } } } },
    "pet.line.highFive2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nice!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "击掌！" } } } },
    "pet.line.pet1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "That feels nice~" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "好舒服～" } } } },
    "pet.line.pet2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "More, please!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "再摸摸～" } } } },
    "pet.line.play1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Let's play!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "来玩呀！" } } } },
    "pet.line.play2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Again, again!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "再来再来！" } } } },
    "pet.line.poke1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hey!" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "嘿！" } } } },
    "pet.line.poke2" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "I'm here~" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在呢～" } } } },

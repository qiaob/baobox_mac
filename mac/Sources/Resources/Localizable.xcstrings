    "phonetransfer.footer.open" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开" } } } },
    "phonetransfer.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Send files and text between this Mac and a phone. The phone doesn’t need an app: scan the QR code and use the browser. LAN mode works on the same Wi-Fi; Internet mode connects directly over the internet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在这台 Mac 和手机之间互传文件和文字。手机不用装 App，扫码后在浏览器里用。局域网模式用于同一 Wi-Fi，公网模式通过互联网直连。" } } } },
    "phonetransfer.settings.receiveSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Receiving" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "接收" } } } },
    "phonetransfer.settings.choose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择…" } } } },
    "phonetransfer.settings.reset" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复默认" } } } },
    "phonetransfer.settings.autoCopy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy received text to the clipboard automatically" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "收到文字时自动复制到剪贴板" } } } },
    "phonetransfer.settings.internetSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Internet Mode" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公网模式" } } } },
    "phonetransfer.settings.pageURL" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Phone page URL" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "手机页面地址" } } } },
    "phonetransfer.settings.pageURLHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The page the QR code opens in Internet mode. Leave empty to use the official one; change it only if you host your own copy (must be https)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "公网模式下二维码打开的网页。留空用官方地址；只有自己部署了一份时才需要改（必须是 https）。" } } } },
    "phonetransfer.lan.interface" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Network" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网卡" } } } },
    "phonetransfer.lan.interface.auto %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic · %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动 · %@" } } } },
    "phonetransfer.lan.interface.all" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "All interfaces" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有网卡" } } } },
    "phonetransfer.lan.interface.allNote" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accepts connections on every interface, including VPNs and virtual adapters." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有网卡上都接受连接，包括 VPN 和虚拟网卡。" } } } },
    "phonetransfer.lan.interface.missing %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ (not available)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@（现在不可用）" } } } },
    "phonetransfer.lan.iface.wifi %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Wi-Fi (%@) · %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Wi-Fi（%@）· %@" } } } },
    "phonetransfer.lan.iface.wired %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ethernet (%@) · %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "有线网络（%@）· %@" } } } },
    "phonetransfer.error.noInterface %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected interface %@ has no IPv4 address right now. Pick another one, or choose Automatic." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选网卡 %@ 现在没有可用的 IPv4 地址。换一块网卡，或选「自动」。" } } } },
    "phonetransfer.image.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制" } } } },
    "phonetransfer.image.copied" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制" } } } },
    "phonetransfer.image.openPreview" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open in Preview" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用「预览」打开" } } } },
    "phonetransfer.image.close" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } } } },
    "phonetransfer.image.loadFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Can’t preview this image." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法预览这张图片。" } } } },
    "phonetransfer.image.previewHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click to preview" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点击预览" } } } },
    "phonetransfer.time.seconds %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ s" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 秒" } } } },
    "phonetransfer.time.took %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "took %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用时 %@" } } } },
    "pet.settings.entrance" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Entrance & Exit Animations" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "出场 / 退场动画" } } } },
    "livetranslate.bar.latest" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Jump to latest" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "回到最新" } } } },
    "livetranslate.bar.loadingModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Loading the translation model — the first time takes a few seconds…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在加载翻译模型，第一次要几秒…" } } } },
    "livetranslate.latency.help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Latency. Speech: from when you start talking again after a pause to the first words on screen. Translation: from a finished chunk to its translation (including AI correction when it's on). Each is the median of the last 5. When a chunk has waited longer than usual, the time it has been waiting is shown instead (with …), so a stuck translation is easy to spot." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "延迟监控。识别：停顿后开口，到字幕上出字；翻译：一截话说完，到译文出来（开了 AI 纠错含纠错时间）。都是最近 5 次的中位数。有一截等译文比平时久时，改为显示它已经等了多久（带 …），翻译卡住一眼看得出。" } } } },
    "livetranslate.latency.recognition %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别 %@" } } } },
    "livetranslate.latency.translation %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译 %@" } } } },
    "livetranslate.notice.sameLanguage %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Already in %@: showing the original only, no translation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说的就是%@：只显示原文，不翻译" } } } },
    "livetranslate.record.barOff" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录" } } } },
    "livetranslate.record.barOn" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录中" } } } },
    "livetranslate.record.choose" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Change…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更改…" } } } },
    "livetranslate.record.choosePrompt" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择" } } } },
    "livetranslate.record.defaultFolderName" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baobox Live Translate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baobox 实时翻译记录" } } } },
    "livetranslate.record.doc.changed %@ %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ changed to: %2$@ · %3$@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ 改为：%2$@ · %3$@" } } } },
    "livetranslate.record.doc.end %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ended: %1$@ (%2$@)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "结束：%1$@（%2$@）" } } } },
    "livetranslate.record.doc.languages %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech: %1$@ · Translate into: %2$@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说：%1$@ · 译成：%2$@" } } } },
    "livetranslate.record.doc.minutes" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纪要" } } } },
    "livetranslate.record.doc.minutesEmpty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The model returned nothing" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "模型没有给出内容" } } } },
    "livetranslate.record.doc.minutesFailed %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't write the minutes: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纪要没整理出来：%@" } } } },
    "livetranslate.record.doc.minutesGenerating" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Writing the minutes with local AI…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在用本地 AI 整理纪要…" } } } },
    "livetranslate.record.doc.minutesInterrupted" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The minutes weren't finished (Baobox quit)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纪要没整理完（Baobox 退出了）。" } } } },
    "livetranslate.record.doc.minutesLater" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When you stop, local AI writes the minutes here (key points, decisions, action items)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止后用本地 AI 整理（要点、结论、待办），写在这里。" } } } },
    "livetranslate.record.doc.minutesNoModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The AI correction model (Qwen3-1.7B) isn't downloaded, so only the transcript was saved. Download it under Settings › Live Translate › AI correction to get minutes next time." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有下载 AI 纠错模型（Qwen3-1.7B），这次只保存了原文和译文。在 设置 › 实时翻译 › AI 纠错 里下载后，以后的记录会自动整理纪要。" } } } },
    "livetranslate.record.doc.minutesTooShort" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Too little was said to write minutes." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内容太少，没有整理纪要。" } } } },
    "livetranslate.record.doc.noTranslation" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No translation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不翻译" } } } },
    "livetranslate.record.doc.source %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Audio source: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音源：%@" } } } },
    "livetranslate.record.doc.start %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Started: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始：%@" } } } },
    "livetranslate.record.doc.title %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live translation %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时翻译记录 %@" } } } },
    "livetranslate.record.doc.transcript" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transcript" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录" } } } },
    "livetranslate.record.enabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save transcripts (Markdown)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存记录（Markdown）" } } } },
    "livetranslate.record.folder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Folder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存位置" } } } },
    "livetranslate.record.help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When on, each live translation session gets its own file with the time, original and translation of every sentence. Sentences are saved as they're finished, so nothing is lost if Baobox quits; changing the source or languages mid-session keeps writing the same file. You can also switch it on or off any time from the Transcript menu on the subtitle bar. Off by default." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开后每次开始实时翻译都新建一份记录：每句的时间、原文和译文，说完一句就写进去，中途退出也不丢；中途改音源、语言等设置会接着写同一份。字幕条「记录」菜单里也能随时开关。默认关。" } } } },
    "livetranslate.record.notifyBody %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Added to the top of “%@”. Menu bar › Live Translate › Open Latest Transcript." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "写在记录「%@」的最前面；菜单栏 › 实时翻译 › 打开最近一次记录。" } } } },
    "livetranslate.record.notifyTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live translation minutes are ready" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时翻译纪要已整理好" } } } },
    "livetranslate.record.openCurrent" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open This Transcript" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开本次记录" } } } },
    "livetranslate.record.openFolder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Transcripts Folder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开记录文件夹" } } } },
    "livetranslate.record.openLatest" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Latest Transcript" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开最近一次记录" } } } },
    "livetranslate.record.section" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Transcript & minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录与纪要" } } } },
    "livetranslate.record.summary" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Write minutes with local AI after stopping (key points, decisions, action items)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止后用本地 AI 整理纪要（要点、结论、待办）" } } } },
    "livetranslate.record.summaryHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uses the Qwen3-1.7B model from AI correction, on this Mac and offline. The minutes go at the top of the transcript and you get a notification when they're ready. Long sessions are summarized in parts first, which can take a minute or two." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用「AI 纠错」的 Qwen3-1.7B 在本机整理，不联网；写在记录最前面，整理好了发通知。记录很长时先分段提要点再合并，可能要一两分钟。" } } } },
    "livetranslate.record.summaryNeedsModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download Qwen3-1.7B under AI correction above first; without it only the transcript is saved." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "要先在上面「AI 纠错」里下载 Qwen3-1.7B；没有模型时只保存原文和译文。" } } } },
    "livetranslate.record.toggleHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click to start or stop saving a transcript (Markdown). Takes effect right away and is remembered." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "点一下开始 / 停止保存记录（Markdown），立刻生效，下次也照这样。" } } } },
    "livetranslate.record.writeFailed %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't save the transcript: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录写不进去：%@" } } } },
    "livetranslate.voice.barPaused" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reading · not listening" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读中 · 暂停识别" } } } },
    "livetranslate.voice.keepListening" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Wearing headphones: keep listening while reading" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "戴着耳机：读的时候也继续听" } } } },
    "livetranslate.voice.keepListeningHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With the microphone as the source and reading through speakers, recognition pauses while it reads so the microphone doesn't pick the voice up again — anything you say meanwhile is lost. With headphones (including AirPods), turn this on to keep listening." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音源是麦克风、又从音响外放朗读时，为了不让麦克风把读出来的声音再识别一遍，读的那几秒会暂停识别，这期间说的话会丢。戴耳机（含 AirPods）时打开它，读的时候也照常识别。" } } } },
    "netcapture.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Network Capture" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网络抓包" } } } },
    "netcapture.menu.start" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Capture" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始抓包" } } } },
    "netcapture.menu.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Capture" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止抓包" } } } },
    "netcapture.menu.openWindow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Capture Window…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开抓包窗口…" } } } },
    "netcapture.menu.proxyToggle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Proxy (Listen)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "代理（监听网络）" } } } },
    "netcapture.menu.scanConfig" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "iOS: Scan to Auto-Configure" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "iOS 扫码自动配置" } } } },
    "netcapture.menu.localProxy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Route This Mac Through Proxy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本机网络走代理" } } } },
    "netcapture.menu.mcp.installClaude" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install MCP (Claude Code)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一键安装 MCP（Claude Code）" } } } },
    "netcapture.menu.mcp.installCodex" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install MCP (Codex)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一键安装 MCP（Codex）" } } } },
    "netcapture.menu.mcp.installCursor" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install MCP (Cursor)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一键安装 MCP（Cursor）" } } } },
    "netcapture.mcp.installFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "MCP install failed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "MCP 安装失败" } } } },

    "focus.preview.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This is what a break looks like. It ends in 10 seconds." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息画面就长这样，10 秒后自动结束。" } } } },
    "focus.preview.bubbleMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This is how Relaxed reminds you: the pet pops up a bubble." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "轻松档到点时就是这样：宠物冒个气泡提醒你。" } } } },
    "focus.preset.water" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drink Water" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "喝水" } } } },
    "focus.preset.stand" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stand Up" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "站立活动" } } } },
    "focus.preset.eye" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Eye Rest 20-20-20" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "护眼 20-20-20" } } } },
    "focus.preset.break" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "整段休息" } } } },
    "focus.preset.custom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Custom Reminder" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义提醒" } } } },

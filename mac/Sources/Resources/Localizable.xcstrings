    "localmodel.confirmDownloadMessage %@ %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ uses about %2$@ of memory while running and this Mac has %3$@; it would freeze. Download anyway?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ 运行时约占 %2$@ 内存，这台 Mac 只有 %3$@，跑起来会卡顿。仍然下载吗？" } } } },

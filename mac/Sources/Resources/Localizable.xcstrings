    "screenshot.settings.drawSavePreviewHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On: saving ends the annotation session and opens a preview (save / extract text / pin / copy). Off: silently copies to the clipboard and saves per your settings while you keep drawing." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启：保存即结束标注并打开预览窗（保存/取字/贴图/复制）。关闭：静默复制到剪贴板并按设置落盘，标注不中断。" } } } },

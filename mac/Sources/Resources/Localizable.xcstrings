    "screenshot.ocr.error.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Nothing was recognized in the selection. Try a tighter selection, or check the recognition languages in Settings › Screenshot." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选区里没能识别出文字。可以框得更贴一些，或到「设置 › 截图」里确认识别语言。" } } } },
    "screenshot.ocr.language.zhEn" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Chinese + English" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "中文 + 英文" } } } },

    "phonetransfer.button.expired" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Expired — Click to Refresh" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已过期，点击刷新" } } } },
    "phonetransfer.status.startingLAN" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starting the local server…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在启动局域网服务…" } } } },
    "phonetransfer.status.startingSignal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connecting to the signaling services…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在连接信令服务…" } } } },
    "phonetransfer.status.scan" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scan the QR code with your phone’s camera." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用手机相机扫描二维码。" } } } },
    "phonetransfer.status.signal %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Signaling services available: %lld of 3" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信令服务可用：%lld / 3" } } } },
    "phonetransfer.status.expired" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The QR code has expired." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "二维码已过期。" } } } },
    "phonetransfer.status.connecting" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allowed. Setting up a direct connection…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已允许，正在建立直连…" } } } },
    "phonetransfer.status.connectedLAN %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已连接：%@" } } } },
    "phonetransfer.status.connected" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已连接" } } } },
    "phonetransfer.status.routeLAN" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected (direct, local network)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已连接（局域网直连）" } } } },
    "phonetransfer.status.routeP2P" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Connected (direct, over the internet)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已连接（公网直连）" } } } },
    "phonetransfer.status.closed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Disconnected. Click “New Session” to connect again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连接已断开。点「新会话」重新连接。" } } } },
    "phonetransfer.error.listen" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t start the local server." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "局域网服务启动失败。" } } } },
    "phonetransfer.error.noLAN" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This Mac isn’t on a local network. Connect to Wi-Fi, or use Internet mode." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 没有连接局域网。请连上 Wi-Fi，或改用公网模式。" } } } },
    "phonetransfer.error.resources" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The web page files are missing from the app bundle." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "App 包里缺少网页文件。" } } } },
    "phonetransfer.error.signal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Can’t reach any signaling service. Check the network, or use LAN mode." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "连不上任何信令服务。请检查网络，或改用局域网模式。" } } } },
    "phonetransfer.error.noWebRTC" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "WebRTC isn’t available on this system, so Internet mode can’t be used. Use LAN mode instead." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此系统不支持 WebRTC，无法使用公网模式，请改用局域网模式。" } } } },
    "phonetransfer.error.noCrypto" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Web encryption isn’t available on this system, so Internet mode can’t be used." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此系统不支持网页加密接口，无法使用公网模式。" } } } },
    "phonetransfer.error.p2p" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn’t connect directly: no direct path could be opened between the phone and this Mac (no relay server is used)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法建立直连：手机和电脑之间没能打通（本功能不使用中继服务器）。" } } } },
    "phonetransfer.nat.phone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Phone network: " } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "手机网络：" } } } },
    "phonetransfer.nat.mac" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Mac network: " } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "电脑网络：" } } } },
    "phonetransfer.nat.ok" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "normal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正常" } } } },
    "phonetransfer.nat.symmetric" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "symmetric NAT (likely)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "对称型 NAT（可能）" } } } },
    "phonetransfer.nat.blocked" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "UDP blocked or probing failed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "UDP 被拦截或探测失败" } } } },
    "phonetransfer.nat.unknown" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "unknown" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未知" } } } },
    "phonetransfer.tips" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Try: put the phone on the same Wi-Fi and switch to LAN mode; connect this Mac to the phone’s hotspot and use LAN mode (always works); or try another network." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可以试试：手机连同一个 Wi-Fi 后切到局域网模式；电脑连手机热点再用局域网模式（一定可用）；或者换个网络。" } } } },
    "phonetransfer.lan.plainNote" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "LAN mode isn’t encrypted. Others on the same Wi-Fi could in theory see the traffic; on public Wi-Fi, use Internet mode." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "局域网模式是明文传输，同一 Wi-Fi 下的其他人理论上可以窃听；在公共 Wi-Fi 上建议用公网模式。" } } } },
    "phonetransfer.internet.note" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Signaling goes through public services (ntfy.sh, public MQTT brokers), encrypted with a key only in the QR code. Files go directly between devices." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "信令经公共服务（ntfy.sh、公共 MQTT）中转，用只存在于二维码里的密钥加密；文件在两台设备之间直传。" } } } },
    "phonetransfer.request.title %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ wants to connect" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 请求连接" } } } },
    "phonetransfer.request.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Only allow devices you recognize." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "只允许你认识的设备。" } } } },
    "phonetransfer.request.allow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "允许" } } } },
    "phonetransfer.request.deny" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Deny" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拒绝" } } } },
    "phonetransfer.drop.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag files here to send them to the phone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把文件拖到这里发送到手机" } } } },

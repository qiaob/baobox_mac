    "meeting.selfTest.micFailed %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't open the microphone: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打不开麦克风：%@" } } } },

    "screendraw.action.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Drawing" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭画笔" } } } },

    "claudecode.settings.config.guardReset" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore default rules" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复默认规则" } } } },
    "claudecode.settings.config.privacy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私" } } } },

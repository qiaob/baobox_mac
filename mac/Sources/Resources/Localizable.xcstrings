    "screenshot.settings.drawScopeHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With one screen the canvas swallows every click on that display, so the others stay fully usable while you draw. Takes effect the next time you start drawing." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选「仅当前屏幕」时，画布只吃掉鼠标所在那块屏的点击，其余屏幕照常使用。改动在下次开始标注时生效。" } } } },

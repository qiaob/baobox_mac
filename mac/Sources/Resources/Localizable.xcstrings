    "netcapture.status.memory %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "~%@ MB" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "约 %@ MB" } } } },

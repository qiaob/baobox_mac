    "claudecode.settings.config.rulePlaceholder" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "e.g. Bash(npm run *)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "如 Bash(npm run *)" } } } },

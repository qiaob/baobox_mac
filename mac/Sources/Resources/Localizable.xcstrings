    "meeting.selfTest.systemUnavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Can't capture — needs Screen Recording permission" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "采不到：需要屏幕录制权限" } } } },

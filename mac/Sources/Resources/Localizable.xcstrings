    "ai.settings.apiKey" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "API key" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "API Key" } } } },
    "ai.settings.baseURL" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Base URL" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "地址" } } } },
    "ai.settings.deleteKey" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "ai.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI features run on this Mac by default. Add providers and models below, then pick the model each feature uses. Text leaves this Mac only for features you set to a cloud model." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 功能默认在本机运行。在下面接入服务商和模型，再给每个功能选用哪个模型；只有选了云端模型的功能，才会把它用到的文字发出去。" } } } },
    "ai.settings.keyHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stored in your Keychain, never in preferences or logs." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存在钥匙串里，不写进偏好设置，也不进日志。" } } } },

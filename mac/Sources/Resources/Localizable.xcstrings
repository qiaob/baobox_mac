    "claudecode.menu.browseSessions" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Browse Session History…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "浏览会话历史…" } } } },
    "claudecode.menu.noWindow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No active usage window" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前无活跃额度窗口" } } } },

    "screenshot.settings.ocrHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognition runs locally via Vision — nothing is uploaded. Fewer languages usually means better accuracy." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别由系统 Vision 在本地完成，不上传任何内容。语言选得越少，准确率通常越高。" } } } },
    "annotation.longCapture" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Scrolling Capture" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长截屏（滚动拼接）" } } } },

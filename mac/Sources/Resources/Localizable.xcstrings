    "claudecode.settings.config.coauthoredHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Affects future commits only; does not rewrite history." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅影响以后的提交，不改写历史。" } } } },

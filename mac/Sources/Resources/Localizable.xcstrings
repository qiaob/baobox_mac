    "meeting.selfTest.recording" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording 3 seconds — say something while some audio plays (a video, say)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在录 3 秒：说句话，同时放点声音（比如一段视频）。" } } } },
    "meeting.selfTest.playing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Playing back the mix…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在回放混音…" } } } },
    "meeting.selfTest.done" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Done. What you just heard is the mix the recognizer gets in an online meeting." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完成。刚才回放的就是线上会议里识别器听到的混音。" } } } },

    "clipboard.tools.qrcode.tooLong" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Too long for a QR code (max 2900 bytes)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内容超过二维码容量上限（2900 字节）。" } } } },
    "clipboard.tools.jwt.expired" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "expired" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已过期" } } } },
    "clipboard.tools.name.timestamp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Timestamp / date" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "时间戳 / 日期" } } } },
    "clipboard.settings.textToolsSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Text tools" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文本工具" } } } },
    "clipboard.settings.textTools" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detect formats in the preview pane" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在预览区识别内容格式" } } } },
    "clipboard.settings.textToolsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Detection runs on the selected item only, on the main thread. Formats you turn off are never run at all, so they cost nothing. Turning the whole thing off restores the plain preview pane." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别只对选中的那一条跑，走主线程。关掉的格式完全不会执行检测，是真正的零开销；整个关掉则预览区回到纯原文显示。" } } } },
    "clipboard.settings.historySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "History" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历史" } } } },
    "clipboard.settings.maxItems %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "History limit: %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历史条数上限：%lld" } } } },
    "clipboard.settings.maxItemsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Oldest non-favorite items are removed once the limit is exceeded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "超出上限时自动淘汰最旧的未收藏条目。" } } } },
    "clipboard.settings.privacySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Privacy" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐私" } } } },
    "clipboard.settings.recordConcealed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record sensitive content from password managers" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录密码管理器的敏感内容" } } } },
    "clipboard.settings.recordConcealedOffHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off: content flagged org.nspasteboard.ConcealedType (passwords copied from 1Password, Bitwarden, Keychain Access, …) is never recorded. Recommended." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭：被标记为 org.nspasteboard.ConcealedType 的内容（1Password / Bitwarden / 钥匙串 等复制出来的密码）不会入库。推荐保持关闭。" } } } },
    "clipboard.settings.recordConcealedOnHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On: passwords copied from password managers are kept in history like any other entry — encrypted on disk, but shown in full in the panel. Turning this off again deletes every sensitive entry already recorded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启：密码管理器复制的密码会和普通条目一样进入历史 —— 磁盘上是加密的，但在面板里明文可见。再次关闭时会删除已记录的全部敏感条目。" } } } },
    "clipboard.settings.transientHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Content flagged org.nspasteboard.TransientType is always ignored — the source app explicitly asks for it not to be stored." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "标记为 org.nspasteboard.TransientType 的临时内容始终忽略 —— 来源 App 明确要求不要保存。" } } } },
    "clipboard.settings.storageSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Storage" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存储" } } } },
    "clipboard.settings.encryptStorage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Encrypt history on disk" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "加密存储历史" } } } },
    "clipboard.settings.encryptStorageOnHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Text and images are sealed with AES-GCM before they are written to ~/Library/Application Support/Baobox/. The key is a random 256-bit key kept in your login keychain — it never leaves this Mac and is not synced to iCloud. Existing history is converted automatically when you flip this switch." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文本与图片写入 ~/Library/Application Support/Baobox/ 前用 AES-GCM 加密。密钥是随机 256-bit，存在登录钥匙串里，不离开这台 Mac、不同步 iCloud。切换开关时已有历史会自动转换格式。" } } } },
    "clipboard.settings.encryptStorageOffHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off: history is written to ~/Library/Application Support/Baobox/ in plain text — anything copied, including passwords, can be read straight off disk." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭：历史以明文写入 ~/Library/Application Support/Baobox/，复制过的任何内容（包括密码）都能直接从磁盘读出来。" } } } },
    "clipboard.settings.encryptionUnavailable" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The keychain is unavailable, so history is written in plain text for now. Unlock your login keychain and restart Baobox." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "钥匙串不可用，历史暂以明文写入。解锁登录钥匙串后重启 Baobox 即可生效。" } } } },
    "clipboard.encryptOffConfirm.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn off history encryption?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭历史加密？" } } } },
    "clipboard.encryptOffConfirm.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The existing history — including images — will be rewritten to disk in plain text, and everything copied from now on will be stored unencrypted. Anyone with access to your user account can read it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已有历史（含图片）会被明文重写回磁盘，之后复制的内容也不再加密。任何能访问你这个用户账户的人都能读到。" } } } },
    "clipboard.encryptOffConfirm.confirm" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭加密" } } } },
    "clipboard.concealedConfirm.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record sensitive clipboard content?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记录敏感剪贴板内容？" } } } },
    "clipboard.concealedConfirm.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Passwords and other content flagged by password managers will be kept in the clipboard history. The history file is encrypted on disk, but entries are shown in full in the panel — anyone using your unlocked Mac can read them. Only enable this if you understand the risk." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "密码管理器标记的密码等内容会进入剪贴板历史。历史文件在磁盘上是加密的，但条目在面板里明文显示 —— 任何能操作你这台已解锁 Mac 的人都看得到。确认了解风险再开启。" } } } },
    "clipboard.concealedConfirm.confirm" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启" } } } },
    "clipboard.settings.clear" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear History…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空历史…" } } } },
    "clipboard.settings.count %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Currently %lld items in history." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前共 %lld 条历史。" } } } },
    "clipboard.clearConfirm.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear clipboard history?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空剪贴板历史？" } } } },
    "clipboard.clearConfirm.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This cannot be undone. Favorites are kept." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此操作无法撤销；收藏条目会保留。" } } } },
    "clipboard.clearConfirm.confirm" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Clear" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "清空" } } } },
    "clipboard.paste.blockedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Cannot Paste This Item" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法粘贴该条目" } } } },
    "clipboard.paste.blockedMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The image file behind this item is missing (it may have been cleaned up). Delete the item." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这条历史的图片文件已丢失（可能被清理），请删除该条目。" } } } },
    "clipboard.paste.noAXTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied — Auto-Paste Is Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制，但自动粘贴未开启" } } } },
    "clipboard.paste.noAXMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The content is on the clipboard — press ⌘V to paste now. Grant Accessibility and future picks will paste automatically." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内容已在剪贴板，现在可直接手动 ⌘V。开启「辅助功能」权限后，选中历史即可自动粘贴到当前 App。" } } } },
    "clipboard.paste.goEnableAX" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Accessibility" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "去开启辅助功能" } } } },
    "clipboard.paste.gotIt" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Got It" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "知道了" } } } },
    "caffeinate.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Awake" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "防休眠" } } } },
    "menubar.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu Bar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单栏" } } } },
    "menubar.menu.status %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld icons hidden" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐藏了 %lld 个图标" } } } },
    "menubar.menu.disabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off — turn it on in Settings" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未启用（在设置里打开）" } } } },
    "menubar.menu.moveBaoboxRight" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move the Baobox Icon to the Right" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把 Baobox 图标放到最右边" } } } },
    "menubar.hotkey.openMenu" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the Baobox Menu" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开 Baobox 菜单" } } } },
    "menubar.hotkey.openMenuHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pops the menu up at the pointer, even when the Baobox icon is squeezed out" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baobox 图标被挤掉时也能在鼠标位置弹出菜单" } } } },
    "menubar.toast.needAccessibility" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hiding and opening icons needs the Accessibility permission" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要「辅助功能」权限才能隐藏、点开图标" } } } },
    "menubar.toast.moveFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't move that icon — hold ⌘ and drag it yourself" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没挪成，可以按住 ⌘ 自己拖过去" } } } },
    "menubar.toast.noRoom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No room in the menu bar to open it — try again from an app with fewer menus" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单栏放不下，没能点开（换个菜单少的 App 再试）" } } } },
    "menubar.toast.noResponse %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ didn't respond — set it to Show and click it in the menu bar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@ 没有反应（可以在设置里改成显示，直接在菜单栏点它）" } } } },
    "menubar.row.squeezed %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ (squeezed out right now)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@（此刻被挤掉）" } } } },
    "menubar.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Icons set to Hide don't take up menu bar space; they live in the first row of the Baobox menu, one click away. Icons squeezed out or behind the notch right now show up in that row too." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选「隐藏」的图标不占菜单栏，在 Baobox 菜单最上面一行，点一下就能用；此刻被挤掉、被刘海挡住的图标也会临时出现在那一行。" } } } },
    "menubar.settings.enabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Manage the menu bar" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用菜单栏管理" } } } },
    "menubar.settings.enabledHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Adds an invisible placeholder to the menu bar. Turning this on moves the Baobox icon to the right end and keeps it visible at all times; turning it off brings every hidden icon back." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单栏里会多一个看不见的占位项。打开时 Baobox 图标会挪到最右边，并且始终保持看得见；关掉后隐藏的图标全部回到菜单栏。" } } } },
    "menubar.settings.position" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baobox icon position" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baobox 图标的位置" } } } },
    "menubar.settings.positionHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Next to the battery and clock, where it won't get squeezed out" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "放到电池、时间旁边，不会再被挤掉" } } } },
    "menubar.settings.moveRight" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to the Right" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "放到最右边" } } } },
    "menubar.settings.itemsSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu bar icons" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单栏上的图标" } } } },
    "menubar.settings.itemsEmpty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No icons found yet. The list refreshes while the menu bar is showing (a full-screen app hides it)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没扫到图标。菜单栏露出来时会自动刷新（全屏 App 里菜单栏是收着的）。" } } } },
    "menubar.settings.itemsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Changing a choice moves that icon right away; the menu bar blinks for a moment. An icon that appears for the first time lands at the far left and starts out hidden — set it to Show to keep it in the menu bar. The clock and Control Center can't be moved and aren't listed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "改了选择立刻挪过去，菜单栏会闪一下。第一次出现的图标系统会排在最左，会先落进隐藏区；想常显示就改成「显示」。时间和控制中心系统不让挪，不列出来。" } } } },
    "menubar.settings.squeezedNow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Squeezed out right now" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "此刻被挤掉" } } } },
    "menubar.settings.show" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Show" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示" } } } },
    "menubar.settings.hide" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hide" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐藏" } } } },
    "menubar.settings.showSqueezed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also put squeezed-out icons in the Baobox menu row" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "被挤掉的图标也临时放进 Baobox 菜单那一行" } } } },
    "menubar.settings.showSqueezedHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "When the front app has many menus or an icon is behind the notch, you can still click it from the Baobox menu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "前台 App 菜单太多、图标被刘海挡住时，在 Baobox 菜单里照样点得到。" } } } },
    "menubar.settings.screenDesc" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Shows what each icon looks like" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "显示图标的样子" } } } },
    "menubar.settings.axDesc" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hides icons and opens hidden ones" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "隐藏图标、点开被藏的图标" } } } },
    "caffeinate.assertionName" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Baobox Keep Awake" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Baobox 防休眠" } } } },
    "caffeinate.status.off" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未开启" } } } },
    "caffeinate.status.infinite" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On · indefinitely" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已开启 · 无限期" } } } },
    "caffeinate.status.remaining %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On · %lld min left" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已开启 · 剩余 %lld 分钟" } } } },
    "caffeinate.menu.startDefault" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start with default duration" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "按默认时长开启" } } } },
    "caffeinate.preset.15m" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On for 15 minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启 15 分钟" } } } },
    "caffeinate.preset.1h" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On for 1 hour" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启 1 小时" } } } },
    "caffeinate.preset.2h" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On for 2 hours" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启 2 小时" } } } },
    "caffeinate.preset.infinite" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On indefinitely" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无限期开启" } } } },
    "caffeinate.menu.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Turn Off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" } } } },
    "caffeinate.action.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow Sleep" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭防休眠" } } } },
    "caffeinate.toast.on" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Awake is on until you turn it off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "防休眠已开启，不会自动关闭" } } } },
    "caffeinate.toast.onFor %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Awake is on — turns off in %lld min" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "防休眠已开启，%lld 分钟后自动关闭" } } } },
    "caffeinate.toast.off" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Awake is off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "防休眠已关闭" } } } },
    "caffeinate.error.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could Not Enable Keep Awake" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法开启防休眠" } } } },
    "caffeinate.hotkey.toggle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Toggle Keep Awake" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开关防休眠" } } } },
    "caffeinate.error.message %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The system failed to create a power assertion (error %lld)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统未能创建电源管理断言（错误码 %lld）。" } } } },
    "caffeinate.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Awake temporarily prevents your Mac from sleeping — useful for long builds, large downloads, or other unattended tasks. Click \"Keep Awake\" in the menu bar to start it for the default duration below; it turns off automatically when time is up. By default only system sleep is blocked (the screen may still turn off); enable the option below to also keep the display on." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "防休眠会临时阻止 Mac 自动进入睡眠，适合跑构建、下载大文件等需要挂机的场景。在菜单栏点击「防休眠」即按下方默认时长开启，到点自动关闭。默认只阻止系统休眠（屏幕仍会正常熄灭），如需屏幕常亮可打开下方选项。" } } } },
    "caffeinate.settings.durationSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Default Duration" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "默认时长" } } } },
    "caffeinate.settings.durationPicker" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Duration for menu and quick start" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单点击或快捷开启时的时长" } } } },
    "caffeinate.settings.15m" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "15 minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "15 分钟" } } } },
    "caffeinate.settings.1h" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "1 hour" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "1 小时" } } } },
    "caffeinate.settings.2h" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "2 hours" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "2 小时" } } } },
    "caffeinate.settings.infinite" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Indefinitely" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无限期" } } } },
    "caffeinate.settings.durationHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Used by \"Start with default duration\" in the menu, the shortcut, and the desktop pet's ring menu; other durations stay available in the submenu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "菜单里的「按默认时长开启」、快捷键和桌面宠物的环形菜单都按这个时长开启；其他时长在二级菜单里选。" } } } },
    "caffeinate.settings.optionsSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Options" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选项" } } } },
    "caffeinate.settings.preventDisplay" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also keep the display awake" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同时防止显示器休眠" } } } },
    "caffeinate.settings.preventDisplayHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The screen stays on too. Changes apply immediately to an active session." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开启后屏幕也不会自动关闭；变更会立即作用于当前正在生效的防休眠。" } } } },
    "windowmanager.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Window Manager" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "窗口管理" } } } },
    "windowmanager.menu.needAX" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility permission required (click to enable)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "需要辅助功能权限（点击开启）" } } } },
    "windowmanager.layout.left" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Left Half" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "左半屏" } } } },
    "windowmanager.layout.right" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Right Half" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "右半屏" } } } },
    "windowmanager.layout.top" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top Half" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "上半屏" } } } },
    "windowmanager.layout.bottom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom Half" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下半屏" } } } },
    "windowmanager.layout.topLeft" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top Left Quarter" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "左上四分之一" } } } },
    "windowmanager.layout.topRight" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Top Right Quarter" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "右上四分之一" } } } },
    "windowmanager.layout.bottomLeft" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom Left Quarter" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "左下四分之一" } } } },
    "windowmanager.layout.bottomRight" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom Right Quarter" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "右下四分之一" } } } },
    "windowmanager.layout.maximize" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Maximize" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "最大化" } } } },
    "windowmanager.layout.maximize.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fills the visible area (not full screen)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "填满可用区域（非全屏）" } } } },
    "windowmanager.layout.center" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Center" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "居中" } } } },
    "windowmanager.layout.center.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keeps the current size" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不改变尺寸" } } } },
    "windowmanager.layout.nextDisplay" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to Next Display" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移到下一个显示器" } } } },
    "windowmanager.layout.prevDisplay" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to Previous Display" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "移到上一个显示器" } } } },
    "windowmanager.layout.restore" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Restore Original Position" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复原始位置" } } } },
    "windowmanager.settings.layoutSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Layout" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "布局" } } } },
    "windowmanager.settings.gap %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Window gap: %lld pt" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "窗口间距：%lld pt" } } } },
    "windowmanager.settings.gapHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Space kept around windows for halves, quarters and maximize; 0 means edge-to-edge." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "半屏、四分屏与最大化时在窗口四周及切分线处留出的间距；0 表示紧贴。" } } } },
    "windowmanager.settings.axDesc" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility is required to move and resize other apps' windows. Without it, actions do nothing." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "窗口管理需要辅助功能权限来移动与缩放其他 App 的窗口。未授权时动作无效。" } } } },
    "windowmanager.settings.hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ships bound to the ⌃⌥ family, which collides with Rectangle and Magnet — rebind one side under Shortcuts if you run both. On multiple displays, layout uses each screen's visible frame (menu bar and Dock excluded) and moving across displays maps proportionally." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "出厂已绑定 ⌃⌥ 系列键位（与 Rectangle / Magnet 同键，若同时使用请在「快捷键」标签页改掉其中一边）。多显示器下按各屏可见区域（避开菜单栏与 Dock）分屏，跨屏移动等比映射。" } } } },
    "common.save" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存" } } } },
    "common.delete" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "clipboard.settings.retention" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto-delete history" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历史自动清理" } } } },
    "clipboard.settings.retention.forever" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Never" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "永不清理" } } } },
    "clipboard.settings.retention.day1" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After 1 day" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "1 天后" } } } },
    "clipboard.settings.retention.days7" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After 7 days" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "7 天后" } } } },
    "clipboard.settings.retention.days30" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After 30 days" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "30 天后" } } } },
    "clipboard.settings.retention.days90" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "After 90 days" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "90 天后" } } } },
    "clipboard.settings.retentionHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Non-favorite items older than this are removed automatically. Favorites are always kept." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "超过该时长的未收藏条目会被自动清理；收藏条目始终保留。" } } } },
    "clipboard.settings.ignoredApps" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ignored apps" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "忽略的 App" } } } },
    "clipboard.settings.ignoredEmpty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No ignored apps yet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无忽略的 App。" } } } },
    "clipboard.settings.addApp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add App…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "添加 App…" } } } },
    "clipboard.settings.addAppPrompt" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Ignore" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "忽略" } } } },
    "clipboard.settings.ignoredAppsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Content copied while these apps are frontmost is never recorded." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些 App 在前台时复制的内容不会被记录。" } } } },
    "screenshot.history.empty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No screenshots yet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无截图" } } } },
    "screenshot.history.pin" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pin to Screen" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "钉到屏幕上" } } } },
    "screenshot.menu.pinFromClipboard" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pin Image from Clipboard" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "从剪贴板贴图" } } } },
    "screenshot.menu.closeAllPins" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close All Pins" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭全部贴图" } } } },
    "screenshot.pins.noImage.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No image in clipboard" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "剪贴板中没有图片" } } } },
    "screenshot.pins.noImage.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy an image first, then pin it from here." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先复制一张图片，再从这里贴到屏幕上。" } } } },
    "screenshot.settings.historySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "History" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "历史" } } } },
    "screenshot.settings.historyLimit %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep last %lld screenshots" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保留最近 %lld 张截图" } } } },
    "screenshot.settings.historyLimitHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Every capture (copy, save or pin) is kept here for quick recovery, independent of files saved to disk." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "每次截图（复制/保存/贴图）都会存入历史便于找回，与保存到磁盘的文件相互独立。" } } } },
    "windowmanager.snapshot.save" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save Current Layout…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存当前布局…" } } } },
    "windowmanager.snapshot.namePrompt.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Save Window Layout" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "保存窗口布局" } } } },
    "windowmanager.snapshot.namePrompt.message %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Records the position and size of %lld windows. Restore them anytime from this menu." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将记录当前 %lld 个窗口的位置与大小，之后可随时从菜单一键恢复。" } } } },
    "windowmanager.snapshot.defaultName %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Layout %lld" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "布局 %lld" } } } },
    "windowmanager.snapshot.emptyCapture.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No windows to save" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有可保存的窗口" } } } },
    "windowmanager.snapshot.emptyCapture.message" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open some windows first, then save the layout." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "先打开一些窗口，再保存布局。" } } } },
    "windowmanager.settings.snapshotSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Layout snapshots" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "布局快照" } } } },
    "windowmanager.settings.snapshotEmpty" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No saved layouts. Create one via “Window Manager → Save Current Layout…” in the menu bar." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有保存的布局。可在菜单栏「窗口管理 → 保存当前布局…」创建。" } } } },
    "windowmanager.settings.snapshotDetail %lld %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$lld windows · %2$@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$lld 个窗口 · %2$@" } } } },
    "screenshot.menu.record" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始录屏" } } } },
    "screenshot.menu.stopRecord" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止录屏" } } } },
    "screenshot.record.hotkey.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record full screen or a region as MP4; press again to stop" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "全屏或框选区域录制为 MP4，再按一次停止" } } } },
    "screenshot.record.hint.click" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Click a window to select it" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "单击窗口选择录制范围" } } } },
    "screenshot.record.hint.drag" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag to select the recording area" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖拽框选录制区域" } } } },
    "screenshot.record.hint.enter" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "⏎ Select the full screen" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "⏎ 选择整个屏幕" } } } },
    "screenshot.record.hud.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止录制" } } } },
    "screenshot.record.error.startFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Could not start recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法开始录制" } } } },
    "screenshot.record.error.saveFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The recording could not be saved" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录制文件保存失败" } } } },
    "screenshot.record.hud.cancel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Discard recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消录制（不保存）" } } } },
    "screenshot.record.bar.audio" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System audio" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统声音" } } } },
    "screenshot.record.bar.mic" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风" } } } },
    "screenshot.record.bar.start" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始录制" } } } },
    "screenshot.record.hud.pause" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂停录制" } } } },
    "screenshot.record.hud.resume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续录制" } } } },
    "screenshot.record.mic.deniedTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Microphone access is off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "麦克风权限未开启" } } } },
    "screenshot.record.mic.deniedMessage" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Baobox in System Settings → Privacy & Security → Microphone, then record again. This recording will continue without the microphone." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请在「系统设置 → 隐私与安全性 → 麦克风」中勾选 Baobox 后重新录制；本次录制将不含麦克风声音。" } } } },
    "screenshot.settings.recordSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recording" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录屏" } } } },
    "screenshot.settings.recordAudio" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record system audio" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录制系统声音" } } } },
    "screenshot.settings.recordMic" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Record microphone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "录制麦克风" } } } },
    "screenshot.settings.recordAudioHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Both can be toggled on the confirm bar before each recording. System audio needs no extra permission; the microphone asks once and is written as a second audio track." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "两项开关也会出现在每次录制前的确认工具条上。系统声音无需额外权限；麦克风首次开启会请求授权，声音写入独立的第二条音轨。" } } } },
    "hotkeys.none" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not set" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未设置" } } } },
    "clipboard.footer.delete" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "clipboard.row.deleteHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete this item (⌘⌫)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除这条记录（⌘⌫）" } } } },
    "pin.menu.resetSize" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reset to Original Size" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "恢复原始大小" } } } },
    "pin.menu.opacity" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Opacity" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "透明度" } } } },
    "screenshot.settings.format" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Output format" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "输出格式" } } } },
    "screenshot.settings.mixAudio" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Merge audio into a single track" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "混合为单条音轨" } } } },
    "screenshot.settings.mixAudioHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With both system audio and microphone on, merging into one track plays correctly everywhere. GIF output is silent, capped at 10 fps and 720px wide — best for short clips." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同时录系统声音与麦克风时，混为单轨可在所有播放器正常出声。GIF 输出无声音、最高 10 帧/秒、宽度缩至 720px，适合短片段。" } } } },
    "selectiontranslate.hotkey.regionOCR" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate Region Text" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选取字翻译" }}}},
    "selectiontranslate.hotkey.regionOCR.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag over any on-screen text — even text that can't be selected — and translate it" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选屏幕上任意文字（包括不能选中的）并翻译" }}}},
    "selectiontranslate.hotkey.translate" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate Selection" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译选中文字" }}}},
    "selectiontranslate.hotkey.translate.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate the text selected in any app, in place" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译任意 App 中选中的文字，就地浮层显示" }}}},
    "selectiontranslate.menu.autoPopup" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pop Up on Selection" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选中后自动弹出" }}}},
    "selectiontranslate.menu.regionOCR" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate Region Text…" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选取字翻译…" }}}},
    "selectiontranslate.menu.translate" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate Selection" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译选中文字" }}}},
    "selectiontranslate.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Selection Translate" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "划词翻译" }}}},
    "selectiontranslate.panel.close" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Close" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "关闭" }}}},
    "selectiontranslate.panel.copied" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copied" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已复制" }}}},
    "selectiontranslate.panel.copy" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Copy" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "复制译文" }}}},
    "selectiontranslate.panel.needsMacOS15" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation needs macOS 15 or later. Speaking still works." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译需要 macOS 15 及以上；朗读仍可使用。" }}}},
    "selectiontranslate.panel.needsScreenRecording" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Region text capture needs Screen Recording permission. Baobox just asked the system — grant it, then restart Baobox." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选取字需要屏幕录制权限，已向系统申请；授权后请重启 Baobox 再试。" }}}},
    "selectiontranslate.panel.noSelection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No selected text detected. Select some text in an app first — or use Region Text for text that can't be selected." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有检测到选中的文字。先在应用里选中文字再试；不能选中的文字请用「框选取字翻译」。" }}}},
    "selectiontranslate.panel.noTextRecognized" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No text recognized in that region." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选区域里没有识别到文字。" }}}},
    "selectiontranslate.panel.speakOriginal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speak" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读原文" }}}},
    "selectiontranslate.panel.speakTranslation" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speak" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读译文" }}}},
    "selectiontranslate.panel.translateFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation failed. Please try again." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译失败，请重试。" }}}},
    "selectiontranslate.panel.translating" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translating…" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在翻译…" }}}},
    "selectiontranslate.settings.accessibility" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能" }}}},
    "selectiontranslate.settings.accessibilityGranted" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Granted" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已授权" }}}},
    "selectiontranslate.settings.accessibilityMissing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Not granted" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未授权" }}}},
    "selectiontranslate.settings.autoPopup" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pop up automatically when text is selected" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选中文字后自动弹出" }}}},
    "selectiontranslate.settings.autoPopupHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Watches for text selections in any app and shows the translation right next to them. Reads the selection via Accessibility first; when an app doesn't expose it, follows the setting below." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "监听全系统的文字选中，浮层就贴在选区旁弹出。优先通过辅助功能读选区；App 不提供时按下面的设置处理。" }}}},
    "selectiontranslate.settings.autoSpeak" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speak the translation automatically" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译完成后自动朗读译文" }}}},
    "selectiontranslate.settings.copyFallback" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Borrow the clipboard when Accessibility can't read the selection" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "辅助功能读不到选区时，借用剪贴板取词" }}}},
    "selectiontranslate.settings.copyFallbackHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For apps that don't expose selected text, such as many terminals: Baobox uses the app's own Copy command, reads the text, and restores your clipboard right away; Baobox's clipboard history doesn't record it. Automatic pop-up only does this after a drag or double-click, and skips it while the clipboard holds a password." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用于不提供选中文字的 App（比如很多终端）：让它用自己的「拷贝」把选区放进剪贴板，读完立即还原原内容，Baobox 的剪贴板历史不会记录。自动弹出只在拖选或双击之后这样做；剪贴板里是密码时不做。" }}}},
    "selectiontranslate.settings.grant" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Grant…" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "去授权…" }}}},
    "selectiontranslate.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select text in any app — browsers, Google Docs, PDFs, even a single word — and a floating panel translates it between English and Chinese right where you selected it, with read-aloud. Text that can't be selected at all (images, scanned PDFs, video) can be captured with Region Text." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在任何 App 里选中文字——浏览器、Google 文档、PDF，单个词也可以——浮层就地英⇄中翻译并可朗读。根本不能选中的文字（图片、扫描版 PDF、视频画面）可以用「框选取字」抓取。" }}}},
    "selectiontranslate.settings.permissionSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Permissions" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "权限" }}}},
    "selectiontranslate.settings.screenRecording" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen Recording" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕录制" }}}},
    "selectiontranslate.settings.screenRecordingHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Screen Recording is only needed for Region Text (reading text that can't be selected). Granting it takes effect after restarting Baobox." }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕录制只在「框选取字」（读不能选中的文字）时需要。授权后需重启 Baobox 才生效。" }}}},
    "selectiontranslate.settings.speakSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读" }}}},
    "selectiontranslate.settings.triggerSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Trigger" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "触发" }}}},
    "selectiontranslate.settings.tryRegion" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Region Text…" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选取字…" }}}},
    "selectiontranslate.settings.trySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Try It" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在试试" }}}},
    "selectiontranslate.settings.tryTranslate" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate Selection" }}, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译选中文字" }}}},
    "claudecode.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code Assistant" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code 助手" } } } },
    "claudecode.hotkey.center" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open Claude Code Center" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开 Claude Code 中心" } } } },
    "claudecode.hotkey.center.subtitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Open the sessions / usage / audit center window" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "打开会话 / 用量 / 审计中心窗口" } } } },
    "claudecode.menu.notInstalled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code not detected (~/.claude missing)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未检测到 Claude Code（~/.claude 不存在）" } } } },
    "claudecode.menu.noActivity" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No activity" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂无活动" } } } },

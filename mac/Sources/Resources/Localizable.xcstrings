    "ai.error.notConfigured" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This cloud model isn't set up yet. Check the AI page in Settings." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个云端模型还没配好，去设置的「AI」页看看。" } } } },

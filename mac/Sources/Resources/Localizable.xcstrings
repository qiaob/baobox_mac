    "focus.status.focusing %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focusing · %@ left" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注中 · 还剩 %@" } } } },
    "focus.status.paused %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus paused · %@ left" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注已暂停 · 还剩 %@" } } } },

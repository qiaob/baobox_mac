    "netcapture.window.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Network Capture" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "网络抓包" } } } },
    "netcapture.window.start" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始" } } } },
    "netcapture.window.stop" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stop" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "停止" } } } },

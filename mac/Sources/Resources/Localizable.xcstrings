    "ai.settings.limitsHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "For all cloud models combined, to avoid surprise bills. Requests over the limit use the local model instead (if downloaded)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所有云端模型合计，防止误刷费用。超过上限的请求改用本地模型（已下载的话）。" } } } },

    "pet.settings.delete" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "pet.settings.download" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载" } } } },
    "pet.settings.character" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Current Character" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "当前形象" } } } },
    "translation.engine.auto" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动" } } } },
    "translation.engine.system" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System Translation (macOS 15+)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统翻译（macOS 15+）" } } } },
    "translation.engine.offline" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Offline Model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "离线模型" } } } },
    "translation.settings.section" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation Engine" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译引擎" } } } },
    "translation.settings.engine" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Engine" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "引擎" } } } },
    "translation.settings.engineHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatic uses System Translation first and switches to the offline model (once downloaded) for languages the system can't translate, or when it fails." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动：优先用系统翻译；系统不支持的语言或翻译失败时，改用离线模型（需先下载）。" } } } },
    "translation.settings.engineHelpNoSystem" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System Translation needs macOS 15, so this Mac translates with the offline model: download it once and everything runs locally." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统翻译要 macOS 15，这台 Mac 用离线模型翻译：下载一次，之后完全在本机运行。" } } } },
    "translation.model.title" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Offline Translation Model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "离线翻译模型" } } } },
    "translation.model.local" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "runs on this Mac" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "完全本地运行" } } } },
    "translation.model.download %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download (%@)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载（%@）" } } } },
    "translation.model.resume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume Download" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续下载" } } } },
    "translation.model.pause" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂停" } } } },
    "translation.model.delete" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Delete" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "删除" } } } },
    "translation.model.retry" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Retry" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } } } },
    "translation.model.notInstalledHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tencent Hunyuan translation model, 33 languages. Once downloaded, translation works without a network. Downloads from Hugging Face and falls back to ModelScope." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "腾讯混元翻译模型，33 种语言，下载后断网也能翻译。先从 Hugging Face 下载，不通时自动换 ModelScope。" } } } },
    "translation.model.verifying" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Verifying the file…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在校验文件…" } } } },
    "translation.model.installed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installed. It starts when you translate and quits after 10 idle minutes to free memory." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已安装。翻译时自动启动，空闲 10 分钟后退出、释放内存。" } } } },
    "translation.model.helperMissing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This build doesn't include the local inference helper (llama-server), so the offline model can't run. Rebuild with make install." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个版本没有打包本地推理组件（llama-server），离线模型无法运行。请用 make install 重新构建。" } } } },
    "translation.error.helperMissing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The local inference helper (llama-server) is missing." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "缺少本地推理组件（llama-server）。" } } } },
    "translation.error.modelMissing" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The offline translation model hasn't been downloaded yet." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "还没有下载离线翻译模型。" } } } },
    "translation.error.serverFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The offline model failed to start." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "离线模型启动失败。" } } } },
    "translation.error.badResponse %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The offline model returned an unexpected response (HTTP %lld)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "离线模型返回了异常结果（HTTP %lld）。" } } } },
    "translation.error.downloadFailed" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download failed." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载失败。" } } } },
    "translation.error.httpStatus %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Download failed (HTTP %lld)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载失败（HTTP %lld）。" } } } },
    "translation.error.checksum" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The downloaded file failed verification and was deleted. Please try again." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载的文件校验失败，已删除，请重试。" } } } },
    "selectiontranslate.panel.changeTarget" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Change target language" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "换一种目标语言" } } } },
    "selectiontranslate.panel.needsOfflineModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System Translation needs macOS 15. Download the offline model to translate on this Mac; Read Aloud works either way." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统翻译要 macOS 15。下载离线翻译模型后，这台 Mac 也能翻译；朗读不受影响。" } } } },
    "selectiontranslate.panel.startingModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Starting the offline model…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正在启动离线模型…" } } } },
    "selectiontranslate.settings.languageSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Languages" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语言" } } } },
    "selectiontranslate.settings.target" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate into" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "译成" } } } },
    "selectiontranslate.settings.secondaryTarget" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "If already in that language, translate into" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原文已是该语言时译成" } } } },
    "selectiontranslate.settings.targetHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The source language is detected automatically. With Chinese as the target and English as the fallback, foreign text goes to Chinese and Chinese goes to English. You can also switch the target right in the popup." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "原文语言自动识别。比如「译成」选中文、备选选 English：外文一律译成中文，中文译成英文。浮层里也能临时换目标语言。" } } } },
    "livetranslate.language.auto %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto (%1$@ / %2$@)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动（%1$@ / %2$@）" } } } },
    "livetranslate.menu.targetHeader" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate Into" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "译成" } } } },
    "livetranslate.notice.needsOfflineModel" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No System Translation on this Mac: download the offline model in Settings. Showing the original only for now." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这台 Mac 没有系统翻译，请在设置里下载离线翻译模型；暂时只显示原文。" } } } },
    "livetranslate.notice.channelDisabled %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%1$@ recognition isn't working, using %2$@ only for now." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%1$@识别不可用，暂时只用%2$@。" } } } },
    "livetranslate.settings.route.switching %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@: on-device (in Auto mode it takes turns with the other language)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@：本机识别（「自动」时和另一种语言轮流识别）" } } } },
    "livetranslate.settings.route.switchingHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Both languages have on-device models and macOS can run only one on-device recognition at a time, so they take turns: once a language change is noticed (about 2.5 s into a sentence) the audio is re-recognized in the other language and it switches, so the first sentence after a change is a second or two slower. If you only speak one language, choose it directly — that's fastest." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "两种语言都装了本机模型，系统一次只能本机识别一种，所以轮流听：发现换了语言（一句话说到 2.5 秒左右就能看出来）就用另一种重认、切过去，换语言后的第一句会慢一两秒。只说一种语言时直接选那种最快。" } } } },
    "livetranslate.status.standby" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "standby" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "待命" } } } },
    "livetranslate.notice.autoSwitching" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto: both languages have on-device models, so they take turns" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「自动」：两种语言都装了本机模型，改为轮流识别" } } } },
    "livetranslate.bar.speech %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "说：%@" } } } },
    "livetranslate.bar.target %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Into: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "译成：%@" } } } },
    "livetranslate.settings.correctionSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI Correction" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 纠错" } } } },
    "livetranslate.settings.aiCorrection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fix recognition mistakes with AI" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 纠正识别错字" } } } },
    "livetranslate.settings.aiCorrectionHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A small local model fixes homophones and typos in recognized Chinese using the surrounding context (e.g. 时事翻译 → 实时翻译), then the corrected text is translated. The draft translation shows first; the corrected text replaces it about a second later. Chinese only for now. Works while translation is on." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "用本地小模型结合上下文改正中文识别里的同音字、错别字（如「时事翻译」→「实时翻译」），再翻译改正后的文字。先显示草稿译文，约 1 秒后换成纠正后的。目前只对中文，开着翻译时生效。" } } } },
    "livetranslate.correction.modelTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Correction model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "纠错模型" } } } },
    "livetranslate.correction.notInstalledHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Alibaba Qwen3-1.7B, runs on this Mac. Downloads from Hugging Face first and switches to ModelScope if that fails." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "阿里通义千问 Qwen3-1.7B，在这台 Mac 上运行。先从 Hugging Face 下载，不通时自动换 ModelScope。" } } } },
    "livetranslate.correction.installedHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installed. Starts with live translation and quits after 10 idle minutes to free memory." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已安装。实时翻译时自动启动，空闲 10 分钟后退出、释放内存。" } } } },
    "livetranslate.status.aiCorrection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "AI correction" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "AI 纠错" } } } },
    "livetranslate.voice.driverTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "“Baobox 同传” virtual microphone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「Baobox 同传」虚拟麦克风" } } } },
    "livetranslate.voice.driverInstalled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Installed. Choose “Baobox 同传” as the microphone in your meeting app." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已安装。会议软件的麦克风里选「Baobox 同传」。" } } } },
    "livetranslate.voice.driverNotInstalled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Adds “Baobox 同传” to the microphone list of meeting apps. Needs your administrator password; all sound pauses for a second or two while it installs." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "装好后，会议软件的麦克风列表里会多出「Baobox 同传」。需要输入管理员密码；安装时系统声音会中断 1～2 秒。" } } } },
    "livetranslate.voice.driverInstall" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Install" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装" } } } },
    "livetranslate.voice.driverUninstall" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uninstall" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "卸载" } } } },
    "livetranslate.voice.driverFailed %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't complete: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没装成：%@" } } } },
    "livetranslate.voice.driverNotLoaded" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The files are installed, but macOS didn't load the device (it may not accept its signature). You can keep using BlackHole for now." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "文件已经装好，但系统没有加载这个设备（可能不认它的签名）。可以先继续用 BlackHole。" } } } },
    "livetranslate.voice.driverNotBundled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "This build doesn't include the virtual microphone driver. Rebuild with make install." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这个版本没有打包虚拟麦克风驱动，请用 make install 重新构建。" } } } },
    "livetranslate.voice.barMeetingNeedsMic" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sent to the meeting only when the audio source is the microphone" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音源是麦克风时才送进会议" } } } },
    "livetranslate.voice.rateSlow" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Slow" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "慢" } } } },
    "livetranslate.voice.rateNormal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Normal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "正常" } } } },
    "livetranslate.voice.rateFast" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fast" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快" } } } },
    "livetranslate.voice.rateFaster" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Faster" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "很快" } } } },
    "livetranslate.voice.section" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read Translations Aloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读译文" } } } },
    "livetranslate.voice.enabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Read translations aloud" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读译文" } } } },
    "livetranslate.voice.help" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Reads each finished translation with the system voice. It can go into a meeting (others hear it as your microphone) and/or play through your speakers." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "把每一截的正式译文用系统语音读出来：可以送进会议（对方当成你的麦克风听到），也可以从音响 / 耳机播放。" } } } },
    "livetranslate.voice.meeting" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Send to meeting (virtual mic)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "送到会议（虚拟麦克风）" } } } },
    "livetranslate.voice.meetingOff" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Don't send (play through speakers / headphones)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不送会议（从音响 / 耳机播放）" } } } },
    "livetranslate.voice.meetingHint %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "In Google Meet (or any meeting app), choose “%@” as the microphone so others hear the translation. Only when the audio source is the microphone (you're the one speaking); with system audio it just plays through your speakers." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在 Google Meet 等会议软件的麦克风里选「%@」，对方就能听到译文。只在音源是麦克风（说话的是你）时送会议；音源是系统声音时只外放。" } } } },
    "livetranslate.voice.noVirtualDevice" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No virtual audio device found. Install the free BlackHole (run brew install blackhole-2ch in Terminal), then come back here to pick it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没找到虚拟声卡。装一个免费的 BlackHole（终端里运行 brew install blackhole-2ch），装好后回到这里就能选。" } } } },
    "livetranslate.voice.speakers" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also play through speakers / headphones" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "同时从音响 / 耳机播放" } } } },
    "livetranslate.voice.mixOriginal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also send my own voice to the meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "我的原声也送进会议" } } } },
    "livetranslate.voice.voiceFor %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%@ voice" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%@音色" } } } },
    "livetranslate.voice.voiceDefault" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System default" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统默认" } } } },
    "livetranslate.voice.rate" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speed" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语速" } } } },
    "livetranslate.voice.preview" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Preview" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "试听" } } } },
    "livetranslate.voice.moreVoices" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Get more natural voices…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "下载更自然的音色…" } } } },
    "livetranslate.voice.feedbackHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "With the microphone as the source and speakers on, recognition pauses while a translation is being read so it isn't recognized again; headphones work best. More natural Enhanced / Premium voices are free under System Settings › Accessibility › Spoken Content › System Voice › Manage Voices." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "音源是麦克风又外放时，读译文期间会暂停识别，免得把读出来的声音又识别一遍；戴耳机效果最好。更自然的「增强 / 高品质」音色在 系统设置 › 辅助功能 › 朗读内容 › 系统声音 › 管理声音 里免费下载。" } } } },
    "livetranslate.voice.qualityEnhanced" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enhanced" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "增强" } } } },
    "livetranslate.voice.qualityPremium" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Premium" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "高品质" } } } },
    "livetranslate.voice.barToggle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Speak" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "朗读" } } } },
    "livetranslate.status.recognition %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Recognition: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别：%@" } } } },
    "livetranslate.status.translation %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translation: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "翻译：%@" } } } },
    "livetranslate.status.onDevice" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "on-device" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "本机" } } } },
    "livetranslate.status.server" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "server" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "服务器" } } } },
    "livetranslate.status.disabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "已停用" } } } },
    "livetranslate.status.engineOffline" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "offline model" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "离线模型" } } } },
    "livetranslate.status.engineSystem" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple Translation" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统翻译" } } } },
    "livetranslate.status.engineOff" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "off" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不翻译" } } } },
    "livetranslate.notice.autoUnavailable %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Auto mode isn't available right now; recognizing %@ only." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "「自动」暂时不可用，只识别%@。" } } } },
    "livetranslate.settings.autoA" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Language A" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语言 A" } } } },
    "livetranslate.settings.autoB" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Language B" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "语言 B" } } } },
    "livetranslate.settings.autoHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Two recognizers listen at once and each sentence goes to whichever language scores higher, which suits bilingual meetings. Uses about twice the CPU." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "两个识别器同时听，每说完一句按把握度判断是哪种语言，适合中英混着说的会议。CPU 占用约翻倍。" } } } },
    "livetranslate.settings.target" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Translate into" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "译成" } } } },
    "livetranslate.settings.targetHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sentences already in this language aren't translated; the original is shown as the subtitle (e.g. with “English”, English speech is shown as is)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "一句话本身就是这种语言时不翻译，原文直接当字幕显示（例如「译成 English」时说英文，只显示英文原文）。" } } } },
    "focus.name" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus & Health" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注与健康" } } } },
    "focus.menu.start %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Start Focus (%lld min)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开始专注（%lld 分钟）" } } } },
    "focus.menu.startWith" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Focus for…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "专注时长" } } } },
    "focus.menu.minutes %lld" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "%lld Minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "%lld 分钟" } } } },
    "focus.menu.pause" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pause Focus" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "暂停专注" } } } },
    "focus.menu.resume" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Resume Focus" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "继续专注" } } } },
    "focus.menu.endEarly" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "End Early" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "提前结束" } } } },
    "focus.menu.endDone" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Count as Done" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "记为完成" } } } },

    "pet.ring.unquiet" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Unmute" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "取消安静" } } } },
    "pet.settings.enabled" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Enable Pet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "启用宠物" } } } },
    "pet.settings.intro" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A little companion on your desktop. Meeting reminders, focus breaks and AI task updates are all delivered through the pet; turn it off and notifications fall back to Notification Center." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "桌面上的小伙伴。会议提醒、专注休息、AI 任务动态都经宠物转达；关掉后通知自动回退系统通知中心。" } } } },
    "pet.settings.moreSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "More Characters" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "更多形象" } } } },
    "pet.settings.notifySection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "通知" } } } },
    "pet.settings.petSection" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Pet" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "宠物" } } } },
    "pet.settings.retry" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Retry" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重试" } } } },
    "pet.settings.activity" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Movement" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "走动" } } } },
    "pet.activity.still" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay Put" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不走动" } } } },
    "pet.activity.calm" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calm: Find a Quiet Spot and Stay" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安静：找个空地待着" } } } },
    "pet.activity.normal" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Normal" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "适中" } } } },
    "pet.activity.lively" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Lively: Wander Around" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "活泼：到处溜达" } } } },
    "pet.settings.avoid" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Keep Out of My Way (Avoid the Window I'm Using)" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不挡我（自动避开正在用的窗口）" } } } },
    "pet.settings.contentAware" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Look at the Screen to Find Blank Areas" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "识别屏幕内容找空白处" } } } },
    "pet.settings.activityHint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Calm: walks to a spot that's out of your way and mostly plays in place, taking a step or two every minute or so and moving somewhere new every 10–20 minutes. Normal: strolls more and moves every few minutes. Lively: the old wandering. Keep out of my way: when it covers the window you're using (after switching apps or desktops, or when you click right next to it), it walks away — or dives into a hole and pops out somewhere free. Where you drop it, it stays for 10 minutes. Blank areas: when no empty desktop is left, it takes a small low-resolution look at the screen with the Screen Recording permission Baobox already has for screenshots, analyses it on this Mac and discards it right away." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安静：走到一个不碍事的地方待着，以原地动作为主，一两分钟挪一两步，十几分钟换个地方。适中：多走动些，几分钟换个地方。活泼：原来的到处溜达。不挡我：挡住你正在用的窗口时（切换 App / 桌面后，或你在它旁边连着点）会走开，远了就钻进黑洞、从空地冒出来；你亲手放的地方先待 10 分钟。识别空白处：找不到空桌面时，用截图功能已有的屏幕录制权限看一眼低分辨率画面，在本机分析完立即丢弃，不保存。" } } } },
    "pet.settings.range" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Where it hangs out" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "活动范围" } } } },
    "pet.settings.rangeHint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom of the screen: walks along the top of the Dock. On app windows too: it can also stand on top of other apps' windows, lie down there, and ride along when you drag the window (in Lively mode it jumps up by itself every few minutes; otherwise only when the window top is a good spot). Stay where I drop it: no gravity, the old behavior." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕底边：沿着 Dock 上沿溜达。窗口上：也会站到别的 App 窗口顶上、趴一会儿，你拖窗口它会跟着走（「活泼」时隔几分钟自己跳上去，其余只在那儿是个好地方时才上去）。随意放：停在你放下的高度，不会往下掉（原来的行为）。" } } } },
    "pet.settings.pickRegion" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Select Area…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "框选区域…" } } } },
    "pet.range.bottom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Bottom of the screen" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "屏幕底边" } } } },
    "pet.range.windows" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On app windows too" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "窗口上" } } } },
    "pet.range.custom" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "A custom area" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自定义区域" } } } },
    "pet.range.screen" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stay where I drop it" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "随意放" } } } },
    "pet.region.hint" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Drag out the area your pet may walk in · Esc to cancel" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "拖出宠物能活动的区域 · Esc 取消" } } } },
    "pet.settings.size" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Size" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "大小" } } } },
    "pet.settings.sound" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Sound for Important Alerts" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "重要提醒响提示音" } } } },
    "pet.settings.sourceClaude" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Claude Code" } } } },
    "pet.settings.sourceCodex" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Codex" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "Codex" } } } },
    "pet.settings.sourceLive" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live Translation Minutes" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时翻译纪要" } } } },
    "pet.source.digest" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Digest" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "汇总" } } } },
    "pet.source.livetranslate" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Live Translate" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "实时翻译" } } } },
    "pet.source.meeting" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Meeting" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议" } } } },
    "pet.test.body" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Notifications from meetings, focus breaks and other apps will appear like this." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "会议、专注休息和其他应用的通知都会像这样出现。" } } } },

    "focus.break.skip" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Skip" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "跳过" } } } },
    "focus.break.holdToSkip" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Hold 3 s to skip" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "长按 3 秒跳过" } } } },
    "focus.break.mini" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "On a break" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "休息中" } } } },

    "localmodel.autostartHelp" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Models with “Start at launch” are started when Baobox launches and stay loaded; others load when a feature needs them and quit after 10 idle minutes. To start Baobox at login, turn it on in General." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "开了「开机自启」的模型，Baobox 一启动就拉起来并常驻；没开的用到时才加载，空闲 10 分钟退出。Baobox 自己要登录时启动，去「通用」里打开。" } } } },
    "localmodel.confirmStartTitle" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Memory may run short" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "内存可能不够" } } } },
    "localmodel.confirmStartMessage %@ %@ %@" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "About %1$@ of memory is available now. Starting %2$@ (about %3$@) may slow the Mac down. Start it anyway?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "现在可用内存约 %1$@，启动 %2$@（约占 %3$@）可能让电脑变慢。确定启动吗？" } } } },

    "ai.settings.keyHelpOpenAI" : { "extractionState" : "manual", "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Stored in your Keychain, never in preferences or logs. Endpoints on this Mac (localhost) don't need a key." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "存在钥匙串里，不写进偏好设置，也不进日志。指向本机（localhost）的服务可以不填。" } } } },
